---
import "../styles/global.css";
import BrandPalette from "../components/BrandPalette.astro";
import FaviconLinks from "../components/FaviconLinks.astro";
import GoogleAdsTracking from "../components/GoogleAdsTracking.astro";
import InternalPageHero from "../components/InternalPageHero.astro";
import PageLoader from "../components/PageLoader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { implantologiaMenuLinks, protesiDentaleMenuLink } from "../data/implantologiaNavigation";
import {
  kebabAllTreatmentsLink,
  kebabTreatmentCategories,
} from "../data/kebabTreatmentNavigation";

const brandLogo = "/assets/brand/sorriso-salute-logo-360.webp";
const desktopNavItems = [
  { label: "La struttura", href: "/chi-siamo/#struttura" },
  { label: "Il nostro team", href: "/chi-siamo/#team" },
  { label: "Come lavoriamo", href: "/chi-siamo/" },
  { label: "Recensioni", href: "/recensioni-studio-dentistico-monza/" },
  { label: "Convenzioni", href: "/convenzioni-dirette-studio-dentistico-monza/" },
];
const mobileNavItems = [
  { label: "Dicono di noi", href: "/recensioni-studio-dentistico-monza/" },
  { label: "La Struttura", href: "/chi-siamo/#struttura" },
  { label: "Convenzioni", href: "/convenzioni-dirette-studio-dentistico-monza/" },
  { label: "Urgenze", href: "/urgenze/" },
  { label: "Chiama in studio: 039 2022489", href: "tel:+390392022489", icon: "phone" },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Urgenze odontoiatriche a Monza: lo Studio Dentistico Sorriso & Salute visita di solito i pazienti il giorno in cui chiamano."
    />
    <meta name="theme-color" content="#0E384C" />
    <link rel="canonical" href="https://sorrisoesalutemonza.it/urgenze/" />
    <title>Urgenze | Studio Dentistico Sorriso & Salute Monza</title>
    <FaviconLinks />
    <GoogleAdsTracking />
    <BrandPalette />
    <style is:inline>
      .urgent-page {
        --urgent-blue: #0e384c;
        --urgent-ink: #10283a;
        --urgent-sky: #edf7fd;
        --urgent-line: #d9e4ec;
        min-height: 100vh;
        margin: 0;
        background: var(--urgent-sky) !important;
        color: var(--urgent-ink);
        font-family: var(--font-family-body);
      }

      .urgent-page * {
        box-sizing: border-box;
      }

      body.urgent-page {
        background: var(--urgent-sky) !important;
      }

      .urgent-page .site-header {
        border-bottom: 1px solid var(--urgent-line);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: none;
        backdrop-filter: none;
      }

      .urgent-page .site-header .brand-logo {
        filter: brightness(0) saturate(100%) invert(15%) sepia(39%) saturate(943%) hue-rotate(164deg) brightness(93%) contrast(94%);
      }

      .urgent-page .desktop-nav a,
      .urgent-page .kebab-button {
        color: var(--urgent-ink);
        text-shadow: none;
      }

      body.urgent-page .kebab-button {
        border: 0 !important;
        background: transparent !important;
        background-color: transparent !important;
        box-shadow: none !important;
        color: var(--urgent-ink) !important;
      }

      .urgent-page .desktop-nav a:hover,
      .urgent-page .desktop-nav a:focus-visible,
      .urgent-page .kebab-button:hover,
      .urgent-page .kebab-button:focus-visible,
      .urgent-page .desktop-nav a[aria-current="page"] {
        color: var(--urgent-blue);
      }

      body.urgent-page .kebab-button:hover,
      body.urgent-page .kebab-button:focus-visible {
        background: transparent !important;
        background-color: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
        color: var(--urgent-ink) !important;
      }

      .urgent-page .kebab-menu {
        background: var(--urgent-blue);
        color: #ffffff;
      }

      .urgent-page .kebab-backdrop {
        background: rgba(8, 42, 56, 0.72);
      }

      body.urgent-page.kebab-menu-open .site-header .brand-logo {
        filter: none !important;
      }

      body.urgent-page .kebab-menu__section h2,
      body.urgent-page .kebab-menu__section a,
      body.urgent-page .kebab-menu__close,
      body.urgent-page .kebab-menu__close span {
        color: #ffffff !important;
      }

      body.urgent-page .kebab-menu__close,
      body.urgent-page .kebab-menu__close:hover,
      body.urgent-page .kebab-menu__close:focus-visible {
        background: transparent !important;
        background-color: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
      }

      .urgent-main {
        min-height: 100vh;
        background: var(--urgent-sky);
      }

      .urgent-hero {
        display: flex;
        align-items: flex-start;
        min-height: 100vh;
        background: var(--urgent-sky);
        padding: clamp(174px, 13.9vw, 246px) clamp(22px, 4vw, 72px) clamp(70px, 9vw, 130px);
      }

      .urgent-hero__inner {
        width: min(1580px, 100%);
        margin: 0 auto;
        text-align: center;
      }

      .urgent-kicker {
        margin: 0 0 clamp(34px, 4vw, 58px);
        color: var(--urgent-ink) !important;
        font-size: clamp(15px, 1.05vw, 19px);
        font-weight: 800;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .urgent-title {
        margin: 0;
        color: #0f172a !important;
        font-size: clamp(52px, 6.2vw, 116px);
        font-weight: 400;
        line-height: 0.96;
        text-transform: uppercase;
      }

      .urgent-lead,
      .urgent-support {
        margin-right: auto;
        margin-left: auto;
        color: var(--color-text-description) !important;
        font-weight: 400;
        line-height: 1.35;
      }

      .urgent-lead {
        max-width: 1500px;
        margin-top: clamp(44px, 4.4vw, 70px);
        font-size: clamp(25px, 2.1vw, 42px);
      }

      .urgent-support {
        max-width: 1440px;
        margin-top: clamp(28px, 3.2vw, 52px);
        font-size: clamp(22px, 1.8vw, 36px);
      }

      .urgent-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        margin-top: clamp(32px, 3.4vw, 48px);
      }

      .urgent-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 58px;
        padding: 0 28px;
        border: 1px solid var(--urgent-blue);
        border-radius: 8px;
        color: var(--urgent-blue) !important;
        font-size: 16px;
        font-weight: 800;
        text-decoration: none;
        transition: transform 180ms ease, box-shadow 180ms ease;
      }

      .urgent-action--primary {
        border-color: var(--urgent-blue);
        background: var(--urgent-blue);
        color: #ffffff !important;
      }

      .urgent-action:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
      }

      body.urgent-page .urgent-kicker,
      body.urgent-page .urgent-title {
        color: var(--urgent-ink) !important;
      }

      body.urgent-page .urgent-title {
        color: #0f172a !important;
      }

      body.urgent-page .urgent-lead,
      body.urgent-page .urgent-support {
        color: var(--color-text-description) !important;
      }

      body.urgent-page .urgent-action:not(.urgent-action--primary) {
        color: var(--urgent-blue) !important;
      }

      @media (max-width: 980px) {
        .urgent-page .mobile-nav > a:last-child {
          display: none;
        }
      }

      @media (max-width: 620px) {
        .urgent-hero {
          padding: 130px 18px 54px;
        }

        .urgent-hero__inner {
          width: calc(100vw - 36px);
          max-width: calc(100vw - 36px);
        }

        .urgent-kicker {
          margin-bottom: 32px;
          font-size: 13px;
        }

        .urgent-title {
          font-size: clamp(42px, 14vw, 62px);
        }

        .urgent-lead {
          margin-top: 38px;
          font-size: 24px;
        }

        .urgent-support {
          margin-top: 30px;
          font-size: 20px;
        }

        .urgent-actions,
        .urgent-action {
          width: 100%;
        }
      }
    </style>
  </head>
  <body class="urgent-page brand-palette internal-page">
    <PageLoader />
    <SiteHeader />

    {false && (
      <Fragment>
        <header class="site-header" data-header hidden aria-hidden="true">
      <a class="brand" href="/" aria-label="Studio Dentistico Sorriso & Salute">
        <img class="brand-logo" src={brandLogo} alt="Studio Dentistico Sorriso & Salute" width="360" height="87" decoding="async" />
      </a>

      <nav class="desktop-nav" aria-label="Navigazione principale">
        {
          desktopNavItems.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>{item.label}</a>
          ))
        }
        <a class="header-booking-cta" href="/richiesta-generale/"><span>Prenota ora</span></a>
      </nav>

      <button
        class="kebab-button"
        type="button"
        aria-label="Apri menu esteso"
        aria-controls="urgenze-kebab-menu"
        aria-expanded="false"
        data-kebab-menu-toggle
      >
        <span class="kebab-button__icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span>Menu</span>
      </button>

      <button
        class="menu-button"
        type="button"
        aria-label="Apri menu"
        aria-expanded="false"
        aria-controls="urgenze-mobile-nav"
        data-menu-button
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav id="urgenze-mobile-nav" class="mobile-nav" aria-label="Menu mobile" data-mobile-nav>
        <details class="mobile-nav__treatments">
          <summary>Trattamenti</summary>
          <div class="mobile-nav__implantology-group" role="group" aria-labelledby="urgent-mobile-menu-implantology-label">
            <span class="mobile-nav__implantology-label" id="urgent-mobile-menu-implantology-label">Implantologia</span>
            <div class="mobile-nav__implantology-links">
              {implantologiaMenuLinks.map((link) => (
                <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined} data-implantology-menu-link>
                  {link.label}
                </a>
              ))}
            </div>
          </div>
          <a href={protesiDentaleMenuLink.href} aria-current={currentPath === protesiDentaleMenuLink.href ? "page" : undefined}>{protesiDentaleMenuLink.label}</a>
        </details>
        {mobileNavItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <div class="kebab-backdrop" data-kebab-backdrop hidden></div>
    <aside id="urgenze-kebab-menu" class="kebab-menu" data-kebab-menu tabindex="-1" aria-label="Menu principale" hidden>
      <div class="kebab-menu__header">
        <button type="button" class="kebab-menu__close" data-kebab-menu-close aria-label="Chiudi menu">
          <span aria-hidden="true">×</span>
          Chiudi
        </button>
      </div>
      <nav class="kebab-menu__content" aria-label="Navigazione estesa">
        <section class="kebab-menu__section">
          <h2>Studio</h2>
          <div class="kebab-menu__link-disclosure" data-kebab-link-disclosure>
            <div class="kebab-menu__link-disclosure-row">
              <a
                id="urgent-menu-about-link"
                class="kebab-menu__link-disclosure-parent-link"
                href="/chi-siamo/"
                aria-current={currentPath === "/chi-siamo/" ? "page" : undefined}
              >
                Chi siamo
              </a>
              <button
                class="kebab-menu__link-disclosure-toggle"
                id="urgent-menu-about-toggle"
                type="button"
                aria-label="Voci di Chi siamo"
                aria-expanded="false"
                aria-controls="urgent-menu-about-links"
                data-kebab-link-disclosure-toggle
              >
                <span class="kebab-menu__link-disclosure-chevron" aria-hidden="true"></span>
              </button>
            </div>
            <div
              class="kebab-menu__link-disclosure-panel"
              id="urgent-menu-about-links"
              role="group"
              aria-labelledby="urgent-menu-about-link"
              data-kebab-link-disclosure-panel
              hidden
            >
              <a href="/chi-siamo/#team">Il nostro team</a>
              <a
                href="/recensioni-studio-dentistico-monza/"
                aria-current={currentPath === "/recensioni-studio-dentistico-monza/" ? "page" : undefined}
              >
                Dicono di noi
              </a>
            </div>
          </div>
          <a href="/chi-siamo/#struttura">La Struttura</a>
        </section>
        <section class="kebab-menu__section kebab-menu__section--treatments">
          <h2>Trattamenti</h2>
          <a href={kebabAllTreatmentsLink.href}>{kebabAllTreatmentsLink.label}</a>
          <div class="kebab-menu__treatment-categories">
            {kebabTreatmentCategories.map((category) => (
              <div class="kebab-menu__treatment-category" data-treatment-category>
                <h3 class="kebab-menu__treatment-category-title">
                  <button
                    class="kebab-menu__treatment-category-toggle"
                    id={`urgent-menu-treatment-${category.id}-toggle`}
                    type="button"
                    aria-expanded="false"
                    aria-controls={`urgent-menu-treatment-${category.id}-panel`}
                    data-treatment-category-toggle
                  >
                    <span>{category.label}</span>
                    <span class="kebab-menu__treatment-category-chevron" aria-hidden="true"></span>
                  </button>
                </h3>
                <div
                  class="kebab-menu__treatment-category-items"
                  id={`urgent-menu-treatment-${category.id}-panel`}
                  role="group"
                  aria-labelledby={`urgent-menu-treatment-${category.id}-toggle`}
                  data-treatment-category-panel
                  hidden
                >
                  {category.items.map((item) => (
                    item.kind === "implantology" ? (
                      <div class="kebab-menu__implantology-group" role="group" aria-labelledby="urgent-menu-implantology-label">
                        <button
                          class="kebab-menu__implantology-parent"
                          id="urgent-menu-implantology-label"
                          type="button"
                          aria-expanded="false"
                          aria-controls="urgent-menu-implantology-links"
                          data-kebab-implantology-toggle
                        >
                          <span class="kebab-menu__implantology-label">{item.label}</span>
                          <span class="kebab-menu__implantology-chevron" aria-hidden="true"></span>
                        </button>
                        <div
                          id="urgent-menu-implantology-links"
                          class="kebab-menu__implantology-links kebab-menu__submenu-panel"
                          data-kebab-implantology-panel
                          hidden
                        >
                          {item.children.map((link) => (
                            <a
                              class="kebab-menu__submenu-link"
                              href={link.href}
                              aria-current={currentPath === link.href ? "page" : undefined}
                              data-implantology-menu-link
                            >
                              {link.label}
                            </a>
                          ))}
                        </div>
                      </div>
                    ) : (
                      <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
                        {item.label}
                      </a>
                    )
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
        <section class="kebab-menu__section">
          <h2>Prenota e informazioni</h2>
          <a href="/urgenze/">Urgenze</a>
          <a href="tel:+390392022489">Chiama in studio: 039 2022489</a>
          <a href="/richiesta-generale/">Richiedi appuntamento</a>
          <a href="/contatti/" aria-current={currentPath === "/contatti/" ? "page" : undefined}>Contatti</a>
          <div class="kebab-menu__link-disclosure" data-kebab-link-disclosure>
            <div class="kebab-menu__link-disclosure-row">
              <a
                id="urgent-menu-conventions-link"
                class="kebab-menu__link-disclosure-parent-link"
                href="/convenzioni-dirette-studio-dentistico-monza/"
                aria-current={currentPath === "/convenzioni-dirette-studio-dentistico-monza/" ? "page" : undefined}
              >
                Convenzioni
              </a>
              <button
                class="kebab-menu__link-disclosure-toggle"
                id="urgent-menu-conventions-toggle"
                type="button"
                aria-label="Voci di Convenzioni"
                aria-expanded="false"
                aria-controls="urgent-menu-conventions-links"
                data-kebab-link-disclosure-toggle
              >
                <span class="kebab-menu__link-disclosure-chevron" aria-hidden="true"></span>
              </button>
            </div>
            <div
              class="kebab-menu__link-disclosure-panel"
              id="urgent-menu-conventions-links"
              role="group"
              aria-labelledby="urgent-menu-conventions-link"
              data-kebab-link-disclosure-panel
              hidden
            >
              <a
                href="/convenzioni-dirette/"
                aria-current={currentPath === "/convenzioni-dirette/" ? "page" : undefined}
              >
                Convenzioni dirette
              </a>
              <a
                href="/convenzioni-indirette/"
                aria-current={currentPath === "/convenzioni-indirette/" ? "page" : undefined}
              >
                Convenzioni indirette
              </a>
            </div>
          </div>
        </section>
      </nav>
        </aside>
      </Fragment>
    )}

    <main class="urgent-main" id="main-content" tabindex="-1">
      <InternalPageHero
        id="urgent-title"
        eyebrow="Urgenze odontoiatriche"
        titlePrimary="Dolore o urgenza?"
        titleAccent="Ti aiutiamo a capire cosa fare."
        lead="Per dolore improvviso, trauma, gonfiore o protesi danneggiata, chiama lo studio e descrivi il problema: ti daremo le indicazioni più adatte e valuteremo la disponibilità nel minor tempo possibile."
        breadcrumbs={[
          { label: "Home", href: "/" },
          { label: "Urgenze odontoiatriche" },
        ]}
      >
        <div slot="actions" class="internal-page-hero__actions">
          <a class="internal-page-hero__button" href="tel:+390392022489">Chiama in studio: 039 2022489</a>
          <a class="internal-page-hero__button internal-page-hero__button--secondary" href="/richiesta-generale/">
            Richiedi appuntamento
          </a>
        </div>
      </InternalPageHero>
    </main>

    <SiteFooter />

    <script is:inline>
      (() => {
        const header = document.querySelector("[data-header]");
        const menuButton = document.querySelector("[data-menu-button]");
        const mobileNav = document.querySelector("[data-mobile-nav]");
        const kebabPanel = document.querySelector("[data-kebab-menu]");
        const kebabBackdrop = document.querySelector("[data-kebab-backdrop]");
        const implantologyToggle = kebabPanel?.querySelector("[data-kebab-implantology-toggle]");
        const implantologyPanel = kebabPanel?.querySelector("[data-kebab-implantology-panel]");
        const treatmentCategoryRecords = Array.from(
          kebabPanel?.querySelectorAll("[data-treatment-category]") ?? [],
        ).flatMap((category) => {
          const toggle = category.querySelector("[data-treatment-category-toggle]");
          const itemsPanel = category.querySelector("[data-treatment-category-panel]");

          if (
            !(category instanceof HTMLElement) ||
            !(toggle instanceof HTMLButtonElement) ||
            !(itemsPanel instanceof HTMLElement)
          ) return [];

          return [{
            category,
            toggle,
            itemsPanel,
          }];
        });
        const linkDisclosureRecords = Array.from(
          kebabPanel?.querySelectorAll("[data-kebab-link-disclosure]") ?? [],
        ).flatMap((disclosure) => {
          const disclosureToggle = disclosure.querySelector("[data-kebab-link-disclosure-toggle]");
          const disclosurePanel = disclosure.querySelector("[data-kebab-link-disclosure-panel]");

          if (
            !(disclosureToggle instanceof HTMLButtonElement) ||
            !(disclosurePanel instanceof HTMLElement)
          ) return [];

          return [{
            toggle: disclosureToggle,
            panel: disclosurePanel,
          }];
        });
        let lastScrollY = window.scrollY;

        const closeMobileMenu = () => {
          menuButton?.setAttribute("aria-expanded", "false");
          mobileNav?.classList.remove("is-open");
        };

        const setImplantologySubmenuState = (isOpen) => {
          if (!(implantologyToggle instanceof HTMLButtonElement) || !(implantologyPanel instanceof HTMLElement)) return;

          implantologyToggle.setAttribute("aria-expanded", String(isOpen));
          implantologyPanel.hidden = !isOpen;
        };

        const setTreatmentCategoryState = (record, isOpen) => {
          record.toggle.setAttribute("aria-expanded", String(isOpen));
          record.itemsPanel.hidden = !isOpen;

          if (!isOpen && implantologyToggle instanceof HTMLElement && record.category.contains(implantologyToggle)) {
            setImplantologySubmenuState(false);
          }
        };

        const resetTreatmentCategoryStates = () => {
          treatmentCategoryRecords.forEach((record) => {
            setTreatmentCategoryState(record, false);
          });
          setImplantologySubmenuState(false);
        };

        const setLinkDisclosureState = (record, isOpen) => {
          record.toggle.setAttribute("aria-expanded", String(isOpen));
          record.panel.hidden = !isOpen;
        };

        const resetLinkDisclosureStates = () => {
          linkDisclosureRecords.forEach((record) => {
            setLinkDisclosureState(record, false);
          });
        };

        const setKebabMenuState = (isOpen) => {
          if (!(kebabPanel instanceof HTMLElement) || !(kebabBackdrop instanceof HTMLElement)) return;

          resetTreatmentCategoryStates();
          resetLinkDisclosureStates();
          kebabPanel.hidden = !isOpen;
          kebabBackdrop.hidden = !isOpen;
          document.body.classList.toggle("kebab-menu-open", isOpen);
          document.querySelectorAll("[data-kebab-menu-toggle]").forEach((button) => {
            button.setAttribute("aria-expanded", String(isOpen));
          });

          if (isOpen) {
            closeMobileMenu();
            header?.classList.remove("is-hidden");
            kebabPanel.focus({ preventScroll: true });
          }
        };

        menuButton?.addEventListener("click", () => {
          const expanded = menuButton.getAttribute("aria-expanded") === "true";
          menuButton.setAttribute("aria-expanded", String(!expanded));
          mobileNav?.classList.toggle("is-open", !expanded);
          setKebabMenuState(false);
          header?.classList.remove("is-hidden");
        });

        const updateStickyHeader = () => {
          if (!header) return;
          const currentScrollY = window.scrollY;
          const isMenuOpen = mobileNav?.classList.contains("is-open");
          const isKebabOpen = kebabPanel instanceof HTMLElement && !kebabPanel.hidden;
          const scrollDelta = currentScrollY - lastScrollY;

          if (currentScrollY < 24 || isMenuOpen || isKebabOpen) {
            header.classList.remove("is-hidden");
            lastScrollY = currentScrollY;
            return;
          }

          if (Math.abs(scrollDelta) < 6) return;

          if (scrollDelta > 0) {
            closeMobileMenu();
            header.classList.add("is-hidden");
          } else {
            header.classList.remove("is-hidden");
          }

          lastScrollY = currentScrollY;
        };

        window.addEventListener("scroll", updateStickyHeader, { passive: true });
        window.addEventListener("resize", updateStickyHeader);

        treatmentCategoryRecords.forEach((record) => {
          record.toggle.addEventListener("click", () => {
            const isOpen = record.toggle.getAttribute("aria-expanded") === "true";
            setTreatmentCategoryState(record, !isOpen);
          });
        });

        linkDisclosureRecords.forEach((record) => {
          record.toggle.addEventListener("click", () => {
            const isOpen = record.toggle.getAttribute("aria-expanded") === "true";
            setLinkDisclosureState(record, !isOpen);
          });
        });

        resetTreatmentCategoryStates();
        resetLinkDisclosureStates();

        mobileNav?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeMobileMenu);
        });

        kebabPanel?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => setKebabMenuState(false));
        });

        implantologyToggle?.addEventListener("click", () => {
          if (!(implantologyToggle instanceof HTMLButtonElement)) return;
          const isOpen = implantologyToggle.getAttribute("aria-expanded") !== "true";
          setImplantologySubmenuState(isOpen);
        });

        document.addEventListener("click", (event) => {
          if (!(event.target instanceof Element)) return;

          const toggle = event.target.closest("[data-kebab-menu-toggle]");
          if (toggle) {
            event.preventDefault();
            setKebabMenuState(kebabPanel instanceof HTMLElement ? kebabPanel.hidden : true);
            return;
          }

          if (event.target.closest("[data-kebab-menu-close]") || event.target === kebabBackdrop) {
            event.preventDefault();
            setKebabMenuState(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          closeMobileMenu();
          setKebabMenuState(false);
        });

        window.addEventListener("hashchange", () => {
          closeMobileMenu();
          setKebabMenuState(false);
        });
      })();
    </script>
  </body>
</html>
