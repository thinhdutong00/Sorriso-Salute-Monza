---
const destination = "/richiesta-generale/";
const canonical = "https://sorrisoesalutemonza.it/richiesta-generale/";
---

<!doctype html>
<html lang="it" data-request-redirect-destination={destination}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <title>Richiedi una valutazione | Sorriso &amp; Salute Monza</title>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${destination}`} />
    </noscript>
  </head>
  <body>
    <p>
      Reindirizzamento al
      <a href={destination} data-request-redirect-link>modulo di richiesta generale</a>.
    </p>

    <script>
      import { captureLeadAttribution } from "../scripts/leadAttribution";

      captureLeadAttribution();

      const redirectDestination =
        document.documentElement.dataset.requestRedirectDestination ||
        "/richiesta-generale/";
      const target = new URL(redirectDestination, window.location.origin);
      target.search = window.location.search;
      target.hash = window.location.hash;

      const legacyProblemMappings = new Map<
        string,
        { service: string; treatment?: string }
      >([
        [
          "dente-mancante",
          {
            service: "implantologia",
            treatment: "implantologia--sostituire-un-solo-dente",
          },
        ],
        [
          "piu-denti-mancanti",
          {
            service: "implantologia",
            treatment: "implantologia--sostituire-piu-denti",
          },
        ],
        [
          "protesi-mobile-instabile",
          {
            service: "implantologia",
            treatment: "implantologia--stabilizzare-una-protesi-mobile",
          },
        ],
        [
          "arcata-completa",
          {
            service: "implantologia",
          },
        ],
      ]);
      const legacyProblem = target.searchParams.get("problema") || "";
      const legacyMapping = legacyProblemMappings.get(legacyProblem);

      if (legacyMapping) {
        if (!target.searchParams.has("servizio")) {
          target.searchParams.set("servizio", legacyMapping.service);
        }
        if (
          legacyMapping.treatment &&
          !target.searchParams.has("trattamento")
        ) {
          target.searchParams.set("trattamento", legacyMapping.treatment);
        }
      }

      const fallbackLink = document.querySelector("[data-request-redirect-link]");
      if (fallbackLink instanceof HTMLAnchorElement) {
        fallbackLink.href = `${target.pathname}${target.search}${target.hash}`;
      }

      if (target.href !== window.location.href) {
        window.location.replace(target.href);
      }
    </script>
  </body>
</html>
