---
import "../styles/global.css";
import FaviconLinks from "../components/FaviconLinks.astro";
import GoogleAdsTracking from "../components/GoogleAdsTracking.astro";
import PageLoader from "../components/PageLoader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import VisitMethodPage from "../components/VisitMethodPage.astro";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Come si svolge una visita presso lo Studio Dentistico Sorriso & Salute di Monza: ascolto, valutazione, spiegazione e prossimi passaggi."
    />
    <meta name="theme-color" content="#0E384C" />
    <link rel="canonical" href="https://sorrisoesalutemonza.it/modalita-della-visita/" />
    <title>Modalità della visita | Sorriso & Salute Monza</title>
    <FaviconLinks />
    <GoogleAdsTracking />
  </head>
  <body class="visit-method-page internal-page">
    <PageLoader />
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <VisitMethodPage />
    </main>

    <SiteFooter />
  </body>
</html>
