<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Percorso implantologico a Monza: parti dalla tua situazione e scopri diagnosi, soluzioni su impianti e controlli con Sorriso & Salute."
    />
    <link rel="canonical" href="https://sorrisoesalutemonza.it/implantologia/" />
    <FaviconLinks />
    <GoogleAdsTracking />
    <title>Percorso implantologico a Monza | Sorriso &amp; Salute</title>
    <style is:global>
      body.implantologia-hub-page {
        --implant-funnel-navy: #0b3474;
        --implant-funnel-navy-deep: #082b63;
        --implant-funnel-sky: #2298d3;
        --implant-funnel-sky-light: #55b8ef;
        --implant-funnel-ink: #11364a;
        --implant-funnel-copy: #526575;
        --implant-funnel-line: rgba(20, 67, 98, 0.12);
        --implant-funnel-surface: #ffffff;
        --implant-funnel-muted: #f2f7fb;
      }

      body.implantologia-hub-page #main-content {
        overflow-x: clip;
      }

      body.implantologia-hub-page .implant-funnel {
        position: relative;
        padding: clamp(88px, 8.5vw, 132px) 24px;
        color: var(--implant-funnel-ink);
      }

      body.implantologia-hub-page .implant-funnel__container {
        width: min(1180px, 100%);
        margin: 0 auto;
      }

      body.implantologia-hub-page .implant-funnel__eyebrow {
        display: flex;
        align-items: center;
        margin: 0 0 18px;
        gap: 12px;
        color: var(--implant-funnel-sky);
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.18em;
        line-height: 1.3;
        text-transform: uppercase;
      }

      body.implantologia-hub-page .implant-funnel__eyebrow::before {
        width: 32px;
        height: 1px;
        flex: 0 0 auto;
        background: currentColor;
        content: "";
      }

      body.implantologia-hub-page .implant-funnel__eyebrow--pill {
        width: fit-content;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(34, 152, 211, 0.1);
        letter-spacing: 0.14em;
      }

      body.implantologia-hub-page .implant-funnel__eyebrow--pill::before {
        width: 6px;
        height: 6px;
        border-radius: 50%;
      }

      body.implantologia-hub-page .implant-funnel__section-intro h2,
      body.implantologia-hub-page .implant-funnel__method-copy h2,
      body.implantologia-hub-page .implant-funnel__process-heading h2,
      body.implantologia-hub-page .implant-funnel__reviews-heading h2,
      body.implantologia-hub-page .implant-funnel__cta-card h2 {
        margin: 0;
        color: var(--implant-funnel-navy);
        font-size: clamp(2.55rem, 5vw, 4.8rem);
        line-height: 0.98;
        text-wrap: balance;
      }

      body.implantologia-hub-page .implant-funnel__section-intro > p:last-child,
      body.implantologia-hub-page .implant-funnel__lead,
      body.implantologia-hub-page .implant-funnel__process-heading > p:last-child {
        margin: 22px 0 0;
        color: var(--implant-funnel-copy);
        font-size: clamp(1rem, 1.4vw, 1.12rem);
        line-height: 1.7;
      }

      body.implantologia-hub-page .implant-funnel--situation {
        padding-top: clamp(92px, 9vw, 142px);
        background:
          radial-gradient(circle at 8% 8%, rgba(85, 184, 239, 0.08), transparent 28rem),
          linear-gradient(180deg, #ffffff 0 18%, var(--implant-funnel-muted) 18% 100%);
      }

      body.implantologia-hub-page .implant-funnel__situation-layout {
        display: grid;
        grid-template-columns: minmax(260px, 0.68fr) minmax(0, 1.32fr);
        align-items: center;
        gap: clamp(42px, 7vw, 92px);
      }

      body.implantologia-hub-page .implant-funnel__section-intro h2 {
        font-size: clamp(2.35rem, 4.2vw, 4rem);
      }

      body.implantologia-hub-page .implant-funnel__definition-card {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        overflow: hidden;
        border: 1px solid var(--implant-funnel-line);
        border-radius: 28px;
        background: var(--implant-funnel-surface);
        box-shadow: 0 22px 55px rgba(10, 55, 91, 0.11);
      }

      body.implantologia-hub-page .implant-funnel__definition-card article {
        min-width: 0;
        padding: clamp(32px, 4vw, 48px);
      }

      body.implantologia-hub-page .implant-funnel__definition-card article + article {
        border-left: 1px solid var(--implant-funnel-line);
      }

      body.implantologia-hub-page .implant-funnel__definition-card article > span {
        color: var(--implant-funnel-sky);
        font-size: 0.72rem;
        font-weight: 850;
        letter-spacing: 0.16em;
      }

      body.implantologia-hub-page .implant-funnel__definition-card h3 {
        margin: 16px 0 14px;
        color: var(--implant-funnel-navy);
        font-size: clamp(1.25rem, 2vw, 1.65rem);
        line-height: 1.12;
      }

      body.implantologia-hub-page .implant-funnel__definition-card article:first-child h3 {
        color: var(--implant-funnel-sky);
      }

      body.implantologia-hub-page .implant-funnel__definition-card p {
        margin: 0;
        color: var(--implant-funnel-copy);
        font-size: 0.96rem;
        line-height: 1.7;
      }

      body.implantologia-hub-page .implant-funnel--method {
        background:
          radial-gradient(circle at 94% 16%, rgba(34, 152, 211, 0.09), transparent 28rem),
          #fbfcfe;
      }

      body.implantologia-hub-page .implant-funnel__method-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(500px, 1.05fr);
        align-items: center;
        gap: clamp(48px, 6vw, 84px);
      }

      body.implantologia-hub-page .implant-funnel__method-copy h2 span,
      body.implantologia-hub-page .implant-funnel__reviews-heading h2 span,
      body.implantologia-hub-page .implant-funnel__cta-card h2 span {
        display: block;
        color: var(--implant-funnel-sky);
      }

      body.implantologia-hub-page .implant-funnel__check-list {
        display: grid;
        margin: 32px 0 0;
        padding: 0;
        gap: 14px;
        list-style: none;
      }

      body.implantologia-hub-page .implant-funnel__check-list li {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--implant-funnel-navy);
        font-size: 0.96rem;
        line-height: 1.4;
      }

      body.implantologia-hub-page .implant-funnel__check-list li > span {
        display: grid;
        width: 22px;
        height: 22px;
        flex: 0 0 22px;
        place-items: center;
        border: 1px solid rgba(34, 152, 211, 0.42);
        border-radius: 50%;
        color: var(--implant-funnel-sky);
        font-size: 0.68rem;
      }

      body.implantologia-hub-page .implant-funnel__method-tiles {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: stretch;
        gap: 18px;
      }

      body.implantologia-hub-page .implant-funnel__method-tile {
        display: flex;
        min-height: 330px;
        flex-direction: column;
        justify-content: space-between;
        padding: 30px;
        border: 1px solid var(--implant-funnel-line);
        border-radius: 26px;
        box-shadow: 0 18px 44px rgba(11, 52, 116, 0.08);
      }

      body.implantologia-hub-page .implant-funnel__method-tile svg {
        width: 48px;
        height: 48px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.7;
      }

      body.implantologia-hub-page .implant-funnel__method-tile > div > span {
        display: block;
        margin-bottom: 10px;
        color: var(--implant-funnel-sky-light);
        font-size: 0.68rem;
        font-weight: 850;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      body.implantologia-hub-page .implant-funnel__method-tile h3 {
        margin: 0;
        font-size: clamp(1.25rem, 2vw, 1.65rem);
        line-height: 1.08;
      }

      body.implantologia-hub-page .implant-funnel__method-tile p {
        margin: 14px 0 0;
        font-size: 0.86rem;
        line-height: 1.55;
      }

      body.implantologia-hub-page .implant-funnel__method-tile--dark {
        border-color: var(--implant-funnel-navy);
        background: var(--implant-funnel-navy);
        color: #ffffff;
      }

      body.implantologia-hub-page .implant-funnel__method-tile--dark p {
        color: rgba(255, 255, 255, 0.74);
      }

      body.implantologia-hub-page .implant-funnel__method-tile--light {
        background: #ffffff;
        color: var(--implant-funnel-navy);
      }

      body.implantologia-hub-page .implant-funnel__method-tile--light p {
        color: var(--implant-funnel-copy);
      }

      body.implantologia-hub-page .implant-funnel--process {
        background: linear-gradient(180deg, #eef5fa 0%, #f5f9fc 100%);
      }

      body.implantologia-hub-page .implant-funnel__process-card {
        padding: clamp(48px, 6vw, 78px);
        border: 1px solid var(--implant-funnel-line);
        border-radius: 34px;
        background: #ffffff;
        box-shadow: 0 20px 58px rgba(17, 54, 74, 0.07);
      }

      body.implantologia-hub-page .implant-funnel__process-heading {
        max-width: 680px;
        margin: 0 auto;
        text-align: center;
      }

      body.implantologia-hub-page .implant-funnel__process-heading .implant-funnel__eyebrow {
        justify-content: center;
      }

      body.implantologia-hub-page .implant-funnel__process-heading h2 {
        font-size: clamp(2.45rem, 4.5vw, 4rem);
      }

      body.implantologia-hub-page .implant-funnel__process-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: clamp(52px, 6vw, 76px);
      }

      body.implantologia-hub-page .implant-funnel__process-grid article {
        position: relative;
        min-width: 0;
        padding: 4px clamp(24px, 3.5vw, 44px) 12px;
      }

      body.implantologia-hub-page .implant-funnel__process-grid article + article {
        border-left: 1px solid var(--implant-funnel-line);
      }

      body.implantologia-hub-page .implant-funnel__step-number {
        position: relative;
        display: inline-block;
        margin-bottom: 20px;
        color: rgba(11, 52, 116, 0.72);
        font-size: clamp(3.3rem, 5vw, 5rem);
        font-weight: 850;
        letter-spacing: -0.08em;
        line-height: 0.8;
      }

      body.implantologia-hub-page .implant-funnel__step-number::before {
        position: absolute;
        top: 48%;
        left: -8px;
        z-index: -1;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(34, 152, 211, 0.16);
        content: "";
        transform: translateY(-50%);
      }

      body.implantologia-hub-page .implant-funnel__process-grid h3 {
        margin: 0;
        color: var(--implant-funnel-navy);
        font-size: 1.15rem;
        line-height: 1.2;
      }

      body.implantologia-hub-page .implant-funnel__process-grid p {
        margin: 13px 0 0;
        color: var(--implant-funnel-copy);
        font-size: 0.9rem;
        line-height: 1.62;
      }

      body.implantologia-hub-page .implant-funnel__trust-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 54px 0 0;
        padding: 28px 0 0;
        gap: 18px;
        border-top: 1px solid var(--implant-funnel-line);
        list-style: none;
      }

      body.implantologia-hub-page .implant-funnel__trust-row li {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--implant-funnel-navy);
        font-size: 0.82rem;
        font-weight: 750;
        text-align: center;
      }

      body.implantologia-hub-page .implant-funnel__trust-row li > span {
        width: 7px;
        height: 7px;
        flex: 0 0 7px;
        border-radius: 50%;
        background: var(--implant-funnel-sky);
      }

      body.implantologia-hub-page .implant-funnel--reviews {
        background:
          radial-gradient(circle at 8% 18%, rgba(85, 184, 239, 0.12), transparent 25rem),
          #eef6fb;
      }

      body.implantologia-hub-page .implant-funnel__reviews-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 36px;
      }

      body.implantologia-hub-page .implant-funnel__reviews-heading h2 {
        max-width: 620px;
      }

      body.implantologia-hub-page .implant-funnel__review-badge {
        display: flex;
        align-items: center;
        min-width: 260px;
        padding: 18px 22px;
        gap: 14px;
        border: 1px solid var(--implant-funnel-line);
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 16px 38px rgba(17, 54, 74, 0.08);
      }

      body.implantologia-hub-page .implant-funnel__review-badge > span {
        display: grid;
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        place-items: center;
        border-radius: 13px;
        background: rgba(34, 152, 211, 0.11);
        color: var(--implant-funnel-sky);
        font-weight: 900;
      }

      body.implantologia-hub-page .implant-funnel__review-badge strong,
      body.implantologia-hub-page .implant-funnel__review-badge small {
        display: block;
      }

      body.implantologia-hub-page .implant-funnel__review-badge strong {
        color: var(--implant-funnel-navy);
        font-size: 0.95rem;
      }

      body.implantologia-hub-page .implant-funnel__review-badge small {
        margin-top: 4px;
        color: var(--implant-funnel-copy);
        font-size: 0.74rem;
      }

      body.implantologia-hub-page .implant-funnel__review-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: clamp(48px, 6vw, 72px);
        gap: 20px;
      }

      body.implantologia-hub-page .implant-funnel__review-card {
        display: flex;
        min-height: 360px;
        flex-direction: column;
        padding: 30px;
        border: 1px solid var(--implant-funnel-line);
        border-radius: 26px;
        background: #ffffff;
        box-shadow: 0 18px 42px rgba(17, 54, 74, 0.07);
      }

      body.implantologia-hub-page .implant-funnel__stars {
        color: #efb20b;
        font-size: 0.9rem;
        letter-spacing: 0.12em;
      }

      body.implantologia-hub-page .implant-funnel__review-card blockquote {
        margin: 22px 0 32px;
        color: var(--implant-funnel-navy);
        font-size: 1rem;
        font-style: italic;
        font-weight: 520;
        line-height: 1.65;
      }

      body.implantologia-hub-page .implant-funnel__review-card footer {
        display: flex;
        align-items: center;
        margin-top: auto;
        gap: 12px;
      }

      body.implantologia-hub-page .implant-funnel__review-initial {
        display: grid;
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        place-items: center;
        border-radius: 13px;
        background: linear-gradient(145deg, var(--implant-funnel-sky), var(--implant-funnel-navy));
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 850;
      }

      body.implantologia-hub-page .implant-funnel__review-card footer strong,
      body.implantologia-hub-page .implant-funnel__review-card footer small {
        display: block;
      }

      body.implantologia-hub-page .implant-funnel__review-card footer strong {
        color: var(--implant-funnel-navy);
        font-size: 0.88rem;
      }

      body.implantologia-hub-page .implant-funnel__review-card footer small {
        margin-top: 3px;
        color: var(--implant-funnel-copy);
        font-size: 0.68rem;
        text-transform: capitalize;
      }

      body.implantologia-hub-page .implant-funnel__review-dots {
        display: flex;
        justify-content: center;
        margin-top: 38px;
        gap: 9px;
      }

      body.implantologia-hub-page .implant-funnel__review-dots span {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(11, 52, 116, 0.2);
      }

      body.implantologia-hub-page .implant-funnel__review-dots span:first-child {
        background: var(--implant-funnel-sky);
      }

      body.implantologia-hub-page .implant-funnel--faq {
        padding-top: clamp(72px, 6vw, 96px);
        padding-bottom: clamp(72px, 6vw, 96px);
        background: #f8fafc;
      }

      body.implantologia-hub-page .implant-funnel__faq-layout {
        display: grid;
        grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
        align-items: start;
        gap: clamp(48px, 8vw, 110px);
      }

      body.implantologia-hub-page .implant-funnel__faq-list {
        display: grid;
        gap: 12px;
      }

      body.implantologia-hub-page .implant-funnel__faq-item {
        overflow: hidden;
        border: 1px solid var(--implant-funnel-line);
        border-radius: 18px;
        background: #ffffff;
      }

      body.implantologia-hub-page .implant-funnel__faq-item summary {
        display: flex;
        min-height: 72px;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px;
        gap: 18px;
        color: var(--implant-funnel-navy);
        cursor: pointer;
        font-size: 0.98rem;
        font-weight: 750;
        line-height: 1.35;
        list-style: none;
      }

      body.implantologia-hub-page .implant-funnel__faq-item summary::-webkit-details-marker {
        display: none;
      }

      body.implantologia-hub-page .implant-funnel__faq-item summary > span:last-child {
        color: var(--implant-funnel-sky);
        font-size: 1.35rem;
        transition: transform 180ms ease;
      }

      body.implantologia-hub-page .implant-funnel__faq-item[open] summary > span:last-child {
        transform: rotate(45deg);
      }

      body.implantologia-hub-page .implant-funnel__faq-item p {
        margin: 0;
        padding: 0 22px 22px;
        color: var(--implant-funnel-copy);
        font-size: 0.92rem;
        line-height: 1.65;
      }

      body.implantologia-hub-page .implant-funnel--cta {
        padding-top: clamp(70px, 7vw, 104px);
        padding-bottom: clamp(48px, 5vw, 72px);
