---
import "../styles/global.css";
import BrandPalette from "../components/BrandPalette.astro";
import FaviconLinks from "../components/FaviconLinks.astro";
import GoogleAdsTracking from "../components/GoogleAdsTracking.astro";
import InternalPageHero from "../components/InternalPageHero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Scegli come prenotare una visita presso lo Studio Dentistico Sorriso & Salute di Monza."
    />
    <meta name="theme-color" content="#0E384C" />
    <FaviconLinks />
    <GoogleAdsTracking />
    <BrandPalette />
    <title>Prenota la tua visita | Sorriso & Salute Monza</title>
  </head>
  <body class="booking-choice-body brand-palette internal-page">
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <InternalPageHero
        id="booking-choice-title"
        eyebrow="Prenotazione"
        titlePrimary="Scegli come contattarci."
        titleAccent="Inizia da qui."
        lead="Puoi chiamare direttamente lo studio oppure inviare online la tua richiesta di visita."
        breadcrumbs={[
          { label: "Home", href: "/" },
          { label: "Prenotazione" },
        ]}
        compact
      >
        <div slot="actions" class="internal-page-hero__actions">
          <a class="internal-page-hero__button internal-page-hero__button--secondary" href="tel:+390392022489">
            Chiama lo studio: 039 2022489
          </a>
          <a class="internal-page-hero__button" href="/richiesta-generale/">Prenota online</a>
        </div>
      </InternalPageHero>
    </main>
    <SiteFooter />
  </body>
</html>
