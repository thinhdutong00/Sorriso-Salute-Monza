---
import "../styles/global.css";
import BrandPalette from "../components/BrandPalette.astro";
import FaviconLinks from "../components/FaviconLinks.astro";
import GoogleAdsTracking from "../components/GoogleAdsTracking.astro";
import InternalPageHero from "../components/InternalPageHero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Grazie per aver richiesto una valutazione allo Studio Dentistico Sorriso & Salute di Monza."
    />
    <meta name="theme-color" content="#0E384C" />
    <FaviconLinks />
    <GoogleAdsTracking />
    <BrandPalette />
    <script is:inline>
      (() => {
        try {
          const leadPendingStorageKey = "lead_conversion_pending_v1";
          const LEAD_CONVERSION_PENDING_TTL_MS = 30 * 60 * 1000;
          const clearLegacyPending = () => {
            window.sessionStorage.removeItem("lead_conversion_scope");
            window.sessionStorage.removeItem("lead_conversion_id");
            window.sessionStorage.removeItem("lead_conversion_pending");
          };
          const rawLeadPending = window.sessionStorage.getItem(leadPendingStorageKey);
          let leadPending = null;

          if (rawLeadPending) {
            try {
              const parsedLeadPending = JSON.parse(rawLeadPending);
              const now = Date.now();
              const isPendingObject =
                parsedLeadPending !== null &&
                typeof parsedLeadPending === "object" &&
                !Array.isArray(parsedLeadPending);
              const hasValidCreatedAt =
                isPendingObject &&
                typeof parsedLeadPending.createdAt === "number" &&
                Number.isFinite(parsedLeadPending.createdAt) &&
                parsedLeadPending.createdAt > 0;
              const isWithinPendingTtl =
                hasValidCreatedAt &&
                parsedLeadPending.createdAt <= now &&
                now - parsedLeadPending.createdAt <
                  LEAD_CONVERSION_PENDING_TTL_MS;
              const transactionId =
                isPendingObject &&
                typeof parsedLeadPending.transactionId === "string"
                  ? parsedLeadPending.transactionId.trim()
                  : "";

              if (
                isPendingObject &&
                parsedLeadPending.version === 1 &&
                parsedLeadPending.scope === "lead" &&
                transactionId &&
                isWithinPendingTtl
              ) {
                leadPending = { transactionId };
              } else {
                window.sessionStorage.removeItem(leadPendingStorageKey);
              }
            } catch {
              window.sessionStorage.removeItem(leadPendingStorageKey);
            }
          }

          if (leadPending) {
            clearLegacyPending();
            const sentKey = `lead_conversion_sent_${leadPending.transactionId}`;
            const wasSent = window.sessionStorage.getItem(sentKey) === "true";

            if (wasSent) {
              window.sessionStorage.removeItem(leadPendingStorageKey);
              return;
            }
            if (typeof window.gtag !== "function") return;

            window.gtag("event", "conversion", {
              send_to: "AW-18196734570/lK03CIzcu7wcEOrE8ORD",
              transaction_id: leadPending.transactionId,
            });
            window.sessionStorage.setItem(sentKey, "true");
            window.sessionStorage.removeItem(leadPendingStorageKey);
            return;
          }

          const scope = window.sessionStorage.getItem("lead_conversion_scope");
          const conversionId = window.sessionStorage.getItem("lead_conversion_id");
          const isPending = window.sessionStorage.getItem("lead_conversion_pending") === "true";
          const sentKey = conversionId ? `lead_conversion_sent_${conversionId}` : "";
          const wasSent = sentKey ? window.sessionStorage.getItem(sentKey) === "true" : true;

          if (scope !== "implantologia" || !conversionId || !isPending || wasSent) return;
          if (typeof window.gtag !== "function") return;

          window.gtag("event", "conversion", {
            send_to: "AW-18196734570/lK03CIzcu7wcEOrE8ORD",
            transaction_id: conversionId,
          });
          window.sessionStorage.setItem("lead_conversion_pending", "false");
          window.sessionStorage.setItem(sentKey, "true");
        } catch {
          // Nessuna conversione viene inviata senza uno stato di sessione valido.
        }
      })();
    </script>
    <title>Grazie | Sorriso & Salute Monza</title>
  </head>
  <body class="request-body brand-palette internal-page">
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <InternalPageHero
        id="thank-you-title"
        eyebrow="Richiesta inviata"
        titlePrimary="Richiesta ricevuta."
        titleAccent="Ti ricontatteremo per confermare."
        lead="Lo studio ti ricontatterà per confermare la prima valutazione e verificare la disponibilità dell’appuntamento indicato."
        breadcrumbs={[
          { label: "Home", href: "/" },
          { label: "Richiesta inviata" },
        ]}
        compact
      >
        <div slot="actions" class="internal-page-hero__actions">
          <a class="internal-page-hero__button" href="/">Torna alla home</a>
          <a class="internal-page-hero__button internal-page-hero__button--secondary" href="/richiesta-generale/">
            Invia una nuova richiesta
          </a>
        </div>
      </InternalPageHero>
    </main>
    <SiteFooter />
  </body>
</html>
