---
import "../styles/internal-pages.css";
import type {
  InternalHeroBreadcrumb,
  InternalHeroCarousel,
  InternalHeroPanel,
} from "../data/internalPageHeroes";

interface Props {
  id?: string;
  sectionId?: string;
  eyebrow: string;
  titlePrimary: string;
  titleAccent: string;
  lead: string;
  breadcrumbs: InternalHeroBreadcrumb[];
  panel?: InternalHeroPanel;
  quote?: string;
  carousel?: InternalHeroCarousel;
  compact?: boolean;
}

const {
  id = "internal-page-title",
  sectionId,
  eyebrow,
  titlePrimary,
  titleAccent,
  lead,
  breadcrumbs,
  panel,
  quote,
  carousel,
  compact = false,
} = Astro.props;
---

<section
  id={sectionId}
  class:list={[
    "internal-page-hero",
    panel && "internal-page-hero--with-panel",
    carousel && "internal-page-hero--with-carousel",
    compact && "internal-page-hero--compact",
  ]}
  aria-labelledby={id}
>
  <div class="internal-page-hero__container">
    <nav class="internal-page-hero__breadcrumb" aria-label="Percorso di navigazione">
      <ol>
        {
          breadcrumbs.map((crumb, index) => (
            <li aria-current={index === breadcrumbs.length - 1 ? "page" : undefined}>
              {crumb.href && index !== breadcrumbs.length - 1 ? (
                <a href={crumb.href}>{crumb.label}</a>
              ) : (
                <span>{crumb.label}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="internal-page-hero__grid">
      <div class="internal-page-hero__copy">
        <p class="internal-page-hero__eyebrow">{eyebrow}</p>
        <h1 id={id}>
          <span class="internal-page-hero__title-primary">{titlePrimary}</span>
          <span class="internal-page-hero__title-accent">{titleAccent}</span>
        </h1>
        <p class="internal-page-hero__lead">{lead}</p>
        {
          quote && (
            <figure class="internal-page-hero__quote">
              <span class="internal-page-hero__quote-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M6.3 11.1h4.2v7.2H3.7v-5.2c0-4.4 2-7.1 6-8.2l.9 2.1c-2.6 1-4 2.3-4.3 4.1Zm10 0h4.1v7.2h-6.8v-5.2c0-4.4 2-7.1 6-8.2l.9 2.1c-2.5 1-3.9 2.3-4.2 4.1Z" fill="currentColor" />
                </svg>
              </span>
              <blockquote>
                <p>{quote}</p>
              </blockquote>
            </figure>
          )
        }
        <slot name="actions" />
      </div>

      {
        panel && (
          <aside class="internal-page-hero__panel" aria-label={panel.title}>
            <div class="internal-page-hero__panel-line" aria-hidden="true">
              <span></span>
            </div>
            <p class="internal-page-hero__panel-label">{panel.label}</p>
            <h2>{panel.title}</h2>
            <ol>
              {panel.items.map((item, index) => (
                <li>
                  <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                  <strong>{item}</strong>
                </li>
              ))}
            </ol>
            <a href={panel.ctaHref}>{panel.ctaLabel}</a>
          </aside>
        )
      }

      {
        carousel && carousel.items.length > 0 && (
          <aside class="internal-page-hero__carousel-column" aria-label={carousel.label}>
            <div
              class="internal-page-hero__carousel"
              data-internal-hero-carousel
              data-autoplay-interval={carousel.interval ?? 4800}
              role="region"
              aria-roledescription="carosello"
              aria-label={carousel.label}
            >
              <div class="internal-page-hero__carousel-viewport">
                {carousel.items.map((item, index) => (
                  <figure
                    class="internal-page-hero__carousel-slide"
                    data-carousel-slide
                    data-active={index === 0 ? "true" : undefined}
                    aria-roledescription="diapositiva"
                    aria-label={`${index + 1} di ${carousel.items.length}`}
                    aria-hidden={index === 0 ? "false" : "true"}
                  >
                    <img
                      src={item.image}
                      width="420"
                      height="630"
                      alt={`Ritratto di ${item.name}`}
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                    <figcaption>
                      <strong>{item.name}</strong>
                      <span>{item.role}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>

              <div class="internal-page-hero__carousel-toolbar">
                <div class="internal-page-hero__carousel-dots" aria-label="Seleziona un componente del team">
                  {carousel.items.map((item, index) => (
                    <button
                      type="button"
                      data-carousel-dot
                      aria-label={`Mostra ${item.name}`}
                      aria-current={index === 0 ? "true" : "false"}
                    >
                      <span aria-hidden="true"></span>
                    </button>
                  ))}
                </div>

                <div class="internal-page-hero__carousel-controls">
                  <button type="button" data-carousel-prev aria-label="Componente del team precedente">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="m14.5 6.5-5 5.5 5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <button type="button" data-carousel-next aria-label="Componente del team successivo">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="m9.5 6.5 5 5.5-5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                </div>
              </div>

              <p class="internal-page-hero__sr-only" data-carousel-status aria-live="polite" aria-atomic="true"></p>
            </div>
          </aside>
        )
      }

      <slot name="aside" />
    </div>
  </div>
</section>

<script>
  const carouselRoots = document.querySelectorAll<HTMLElement>("[data-internal-hero-carousel]");

  carouselRoots.forEach((root) => {
    if (root.dataset.carouselReady === "true") return;
    root.dataset.carouselReady = "true";

    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
    const previousButton = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const status = root.querySelector<HTMLElement>("[data-carousel-status]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const parsedInterval = Number(root.dataset.autoplayInterval);
    const interval = Number.isFinite(parsedInterval) ? Math.max(parsedInterval, 3000) : 4800;
    let currentIndex = 0;
    let timer: number | undefined;

    const showSlide = (nextIndex: number, announce = false) => {
      if (slides.length === 0) return;
      currentIndex = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        const active = index === currentIndex;
        if (active) slide.dataset.active = "true";
        else delete slide.dataset.active;
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });

      dots.forEach((dot, index) => {
        dot.setAttribute("aria-current", index === currentIndex ? "true" : "false");
      });

      if (announce && status) {
        const caption = slides[currentIndex]?.querySelector("strong")?.textContent?.trim();
        status.textContent = `${caption ?? "Componente del team"}, immagine ${currentIndex + 1} di ${slides.length}`;
      }
    };

    const stopAutoplay = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (reducedMotion.matches || document.hidden || slides.length < 2) return;
      timer = window.setInterval(() => showSlide(currentIndex + 1), interval);
    };

    const moveTo = (nextIndex: number) => {
      showSlide(nextIndex, true);
      startAutoplay();
    };

    previousButton?.addEventListener("click", () => moveTo(currentIndex - 1));
    nextButton?.addEventListener("click", () => moveTo(currentIndex + 1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => moveTo(index)));
    document.addEventListener("visibilitychange", startAutoplay);
    reducedMotion.addEventListener("change", startAutoplay);

    showSlide(0);
    startAutoplay();
  });
</script>
