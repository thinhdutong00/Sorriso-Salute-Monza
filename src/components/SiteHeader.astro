---
import { kebabTreatmentCategories } from "../data/kebabTreatmentNavigation";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;
const logo = "/assets/brand/sorriso-salute-logo-360.webp";

const informationLinks = [
  { href: "/chi-siamo/", label: "Chi siamo" },
  { href: "/chi-siamo/#come-lavoriamo", label: "Come lavoriamo" },
  { href: "/chi-siamo/#team", label: "Il nostro team" },
  { href: "/recensioni-studio-dentistico-monza/", label: "Recensioni" },
  { href: "/tutte-le-convenzioni/", label: "Convenzioni" },
];

const contactLinks = [
  { href: "/contatti/", label: "Contatti" },
  { href: "/urgenze/", label: "Urgenze" },
  { href: "/lavora-con-noi/", label: "Lavora con noi" },
  {
    href: "/le-nostre-piattaforme-di-prenotazione/",
    label: "Prenota una visita",
  },
];

const treatmentGroups = kebabTreatmentCategories.map((category) => ({
  id: category.id,
  label: category.label,
  links: category.items.flatMap((item) =>
    item.kind === "implantology"
      ? item.children
      : [{ href: item.href, label: item.label }],
  ),
}));

const informationIsActive =
  currentPath.startsWith("/chi-siamo") ||
  currentPath.startsWith("/recensioni-") ||
  currentPath.startsWith("/convenzioni-") ||
  currentPath === "/tutte-le-convenzioni/";
const treatmentsIsActive =
  currentPath.startsWith("/attivita/") ||
  currentPath.startsWith("/implantologia/") ||
  currentPath === "/protesi-dentale/";
const visitIsActive = currentPath === "/modalita-della-visita/";
const contactsIsActive =
  currentPath === "/contatti/" ||
  currentPath === "/urgenze/" ||
  currentPath === "/lavora-con-noi/" ||
  currentPath === "/richiesta-generale/" ||
  currentPath === "/le-nostre-piattaforme-di-prenotazione/";
---

<a class="primary-site-skip-link" href="#main-content">Vai al contenuto</a>

<header
  class:list={[
    "primary-site-header",
    overlay && "primary-site-header--overlay",
  ]}
  data-primary-site-header
>
  <div class="primary-site-header__inner">
    <a class="primary-site-header__brand" href="/" aria-label="Studio Dentistico Sorriso & Salute — Home">
      <img
        src={logo}
        alt="Studio Dentistico Sorriso & Salute"
        width="360"
        height="87"
        decoding="async"
      />
    </a>

    <nav class="primary-site-header__desktop-nav" aria-label="Navigazione principale">
      <div
        class:list={[
          "primary-site-header__item",
          informationIsActive && "is-current",
        ]}
        data-header-dropdown
      >
        <div class="primary-site-header__item-trigger">
          <a href="/chi-siamo/" aria-current={currentPath === "/chi-siamo/" ? "page" : undefined}>
            Informazioni
          </a>
          <button
            type="button"
            aria-label="Apri il menu Informazioni"
            aria-expanded="false"
            aria-controls="header-information-menu"
            data-header-dropdown-toggle
          >
            <span class="primary-site-header__chevron" aria-hidden="true"></span>
          </button>
        </div>
        <div
          class="primary-site-header__dropdown primary-site-header__dropdown--simple"
          id="header-information-menu"
          data-header-dropdown-panel
        >
          <p class="primary-site-header__dropdown-eyebrow">Informazioni sullo studio</p>
          {
            informationLinks.map((link) => (
              <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      <div
        class:list={[
          "primary-site-header__item",
          "primary-site-header__item--treatments",
          treatmentsIsActive && "is-current",
        ]}
        data-header-dropdown
      >
        <div class="primary-site-header__item-trigger">
          <a href="/attivita/" aria-current={currentPath === "/attivita/" ? "page" : undefined}>
            Trattamenti
          </a>
          <button
            type="button"
            aria-label="Apri il menu Trattamenti"
            aria-expanded="false"
            aria-controls="header-treatments-menu"
            data-header-dropdown-toggle
          >
            <span class="primary-site-header__chevron" aria-hidden="true"></span>
          </button>
        </div>
        <div
          class="primary-site-header__dropdown primary-site-header__dropdown--treatments"
          id="header-treatments-menu"
          data-header-dropdown-panel
        >
          <div class="primary-site-header__treatment-list">
            <a class="primary-site-header__all-treatments" href="/attivita/">
              <span>Tutti i trattamenti</span>
              <small>Panoramica dei servizi</small>
            </a>
            {
              treatmentGroups.map((group) => (
                <div class="primary-site-header__treatment-group" data-treatment-flyout>
                  <button
                    type="button"
                    aria-expanded="false"
                    aria-controls={`header-treatment-${group.id}`}
                    data-treatment-flyout-toggle
                  >
                    <span>{group.label}</span>
                    <span class="primary-site-header__flyout-arrow" aria-hidden="true"></span>
                  </button>
                  <div
                    class="primary-site-header__treatment-flyout"
                    id={`header-treatment-${group.id}`}
                    data-treatment-flyout-panel
                  >
                    <p>{group.label}</p>
                    {
                      group.links.map((link) => (
                        <a
                          href={link.href}
                          aria-current={currentPath === link.href ? "page" : undefined}
                        >
                          {link.label}
                        </a>
                      ))
                    }
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <a
        class:list={[
          "primary-site-header__direct-link",
          visitIsActive && "is-current",
        ]}
        href="/modalita-della-visita/"
        aria-current={visitIsActive ? "page" : undefined}
      >
        Modalità della visita
      </a>

      <div
        class:list={[
          "primary-site-header__item",
          contactsIsActive && "is-current",
        ]}
        data-header-dropdown
      >
        <div class="primary-site-header__item-trigger">
          <a href="/contatti/" aria-current={currentPath === "/contatti/" ? "page" : undefined}>
            Contatti
          </a>
          <button
            type="button"
            aria-label="Apri il menu Contatti"
            aria-expanded="false"
            aria-controls="header-contacts-menu"
            data-header-dropdown-toggle
          >
            <span class="primary-site-header__chevron" aria-hidden="true"></span>
          </button>
        </div>
        <div
          class="primary-site-header__dropdown primary-site-header__dropdown--simple primary-site-header__dropdown--right"
          id="header-contacts-menu"
          data-header-dropdown-panel
        >
          <p class="primary-site-header__dropdown-eyebrow">Contatti e appuntamenti</p>
          {
            contactLinks.map((link) => (
              <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="primary-site-header__actions" aria-label="Contatti rapidi">
      <a
        class="primary-site-header__phone"
        href="tel:+390392022489"
        aria-label="Chiama lo studio al numero 039 2022489"
      >
        <span class="primary-site-header__phone-icon" aria-hidden="true">☎</span>
        <span class="primary-site-header__phone-label">039 2022489</span>
      </a>
      <a class="primary-site-header__booking" href="/richiesta-generale/">
        Prenota una visita
      </a>
      <button
        class="primary-site-header__mobile-toggle"
        type="button"
        aria-label="Apri il menu di navigazione"
        aria-expanded="false"
        aria-controls="primary-site-mobile-menu"
        data-header-mobile-toggle
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div
    class="primary-site-header__mobile-menu"
    id="primary-site-mobile-menu"
    data-header-mobile-menu
    hidden
  >
    <nav aria-label="Navigazione mobile">
      <details>
        <summary>Informazioni</summary>
        <div class="primary-site-header__mobile-links">
          {
            informationLinks.map((link) => (
              <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
      </details>

      <details>
        <summary>Trattamenti</summary>
        <div class="primary-site-header__mobile-links">
          <a href="/attivita/">Tutti i trattamenti</a>
          {
            treatmentGroups.map((group) => (
              <details class="primary-site-header__mobile-treatment">
                <summary>{group.label}</summary>
                <div>
                  {
                    group.links.map((link) => (
                      <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                        {link.label}
                      </a>
                    ))
                  }
                </div>
              </details>
            ))
          }
        </div>
      </details>

      <a href="/modalita-della-visita/" aria-current={visitIsActive ? "page" : undefined}>
        Modalità della visita
      </a>

      <details>
        <summary>Contatti</summary>
        <div class="primary-site-header__mobile-links">
          {
            contactLinks.map((link) => (
              <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <div class="primary-site-header__mobile-actions">
      <a href="tel:+390392022489">Chiama 039 2022489</a>
      <a href="/richiesta-generale/">Prenota una visita</a>
    </div>
  </div>
</header>

<style is:global>
  :root {
    --primary-site-header-height: 98px;
    --implant-home-header-height: 98px;
  }

  :is(#come-lavoriamo, #struttura, #team, #dove-siamo) {
    scroll-margin-top: calc(var(--primary-site-header-height) + 24px);
  }

  .primary-site-skip-link {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 10001;
    padding: 12px 16px;
    border-radius: 10px;
    background: #fff;
    color: #082a38 !important;
    font: 700 0.9rem/1 var(--font-family-navigation, system-ui, sans-serif);
    transform: translateY(-180%);
    transition: transform 160ms ease;
  }

  .primary-site-skip-link:focus {
    transform: translateY(0);
  }

  .primary-site-header {
    --primary-header-floating-top: clamp(12px, 1.1vw, 18px);
    --primary-header-floating-inline: clamp(18px, 2.8vw, 56px);
    --primary-header-foreground: #082a38;
    --primary-header-accent: #1e84b5;
    --primary-header-control-border: var(--brand-primary, #0e384c);
    --primary-header-control-hover: var(--brand-primary, #0e384c);
    --primary-header-control-hover-border: var(--brand-primary, #0e384c);
    --primary-header-control-hover-color: #fff;
    --primary-header-phone-background: #fff;
    --primary-header-phone-color: var(--brand-primary, #0e384c);
    --primary-header-booking-background: var(--brand-secondary, #1e84b5);
    --primary-header-booking-border: var(--brand-secondary, #1e84b5);
    --primary-header-booking-color: #fff;
    --primary-header-booking-hover-background: #fff;
    --primary-header-booking-hover-border: var(--brand-primary, #0e384c);
    --primary-header-booking-hover-color: var(--brand-primary, #0e384c);
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 900;
    width: auto;
    min-height: 98px;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.1);
    color: var(--primary-header-foreground);
    font-family: var(--font-family-navigation, system-ui, sans-serif);
    backdrop-filter: blur(14px);
    transform: translateY(0);
    transition:
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      top 360ms cubic-bezier(0.22, 1, 0.36, 1),
      right 360ms cubic-bezier(0.22, 1, 0.36, 1),
      left 360ms cubic-bezier(0.22, 1, 0.36, 1),
      min-height 360ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 360ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      box-shadow 220ms ease;
    will-change: transform;
  }

  .primary-site-header.is-floating {
    top: var(--primary-header-floating-top);
    right: var(--primary-header-floating-inline);
    left: var(--primary-header-floating-inline);
    min-height: 82px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 22px 54px rgba(14, 56, 76, 0.15);
    backdrop-filter: blur(16px);
  }

  .primary-site-header--overlay:not(.is-scrolled, .is-mobile-open) {
    --primary-header-foreground: #fff;
    --primary-header-accent: #bfe8f7;
    --primary-header-control-border: #fff;
    background: transparent;
    box-shadow: none;
    backdrop-filter: none;
  }

  body.home .primary-site-header--overlay:not(.is-scrolled, .is-mobile-open) {
    background: rgba(8, 42, 56, 0.12);
    backdrop-filter: blur(6px);
  }

  .primary-site-header.is-hidden {
    pointer-events: none;
    transform: translateY(-150%);
  }

  .primary-site-header *,
  .primary-site-header *::before,
  .primary-site-header *::after {
    box-sizing: border-box;
  }

  .primary-site-header a {
    color: inherit !important;
    text-decoration: none !important;
  }

  body.brand-palette .primary-site-header button,
  .primary-site-header button {
    margin: 0;
    border: 0;
    background: transparent !important;
    box-shadow: none !important;
    color: inherit;
    font: inherit;
  }

  .primary-site-header__inner {
    display: grid;
    grid-template-columns: minmax(190px, 252px) minmax(480px, 1fr) auto;
    align-items: center;
    width: min(1840px, 100%);
    min-height: 98px;
    margin: 0 auto;
    padding: 20px clamp(20px, 3.2vw, 58px) 14px;
    gap: clamp(20px, 2.2vw, 40px);
    transition:
      min-height 360ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .primary-site-header.is-floating .primary-site-header__inner {
    min-height: 82px;
    padding-block: 10px;
  }

  .primary-site-header__brand {
    display: inline-flex;
    width: min(252px, 100%);
    min-width: 0;
  }

  .primary-site-header__brand img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(15%) sepia(39%) saturate(943%) hue-rotate(164deg) brightness(93%) contrast(94%);
    transition: filter 220ms ease;
  }

  .primary-site-header--overlay:not(.is-scrolled, .is-mobile-open) .primary-site-header__brand img {
    filter: none;
  }

  .primary-site-header__desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    gap: clamp(18px, 1.7vw, 34px);
  }

  .primary-site-header__item,
  .primary-site-header__direct-link {
    position: relative;
    flex: 0 0 auto;
  }

  .primary-site-header__direct-link,
  .primary-site-header__item-trigger > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    color: var(--primary-header-foreground) !important;
    font-size: clamp(0.78rem, 0.78vw, 0.92rem);
    font-weight: 760;
    letter-spacing: 0.055em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .primary-site-header__item-trigger {
    display: flex;
    align-items: center;
  }

  body.brand-palette .primary-site-header .primary-site-header__item-trigger > button,
  .primary-site-header__item-trigger > button {
    display: grid;
    width: 30px;
    height: 44px;
    padding: 0 0 0 8px;
    color: var(--primary-header-foreground) !important;
    cursor: pointer;
    place-items: center;
  }

  .primary-site-header__chevron {
    display: block;
    width: 8px;
    height: 8px;
    border-right: 1.8px solid currentColor;
    border-bottom: 1.8px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 160ms ease;
  }

  .primary-site-header__item.is-open .primary-site-header__chevron,
  .primary-site-header__item:hover .primary-site-header__chevron {
    transform: translateY(2px) rotate(225deg);
  }

  .primary-site-header__item:hover .primary-site-header__item-trigger > a,
  .primary-site-header__item:focus-within .primary-site-header__item-trigger > a,
  .primary-site-header__direct-link:hover,
  .primary-site-header__direct-link:focus-visible {
    color: var(--primary-header-foreground) !important;
  }

  .primary-site-header__item.is-current .primary-site-header__item-trigger > a,
  .primary-site-header__direct-link.is-current {
    color: var(--primary-header-accent) !important;
  }

  .primary-site-header__item-trigger > a::after,
  .primary-site-header__direct-link::after {
    position: absolute;
    right: 0;
    bottom: 3px;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    content: "";
    opacity: 0;
    transform: scaleX(0.35);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .primary-site-header__item.is-current .primary-site-header__item-trigger > a::after,
  .primary-site-header__direct-link.is-current::after,
  .primary-site-header__item:hover .primary-site-header__item-trigger > a::after,
  .primary-site-header__item:focus-within .primary-site-header__item-trigger > a::after,
  .primary-site-header__direct-link:hover::after,
  .primary-site-header__direct-link:focus-visible::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .primary-site-header__dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    z-index: 5;
    visibility: hidden;
    padding: 18px;
    border: 1px solid rgba(14, 56, 76, 0.1);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 26px 70px rgba(8, 42, 56, 0.24);
    color: #082a38;
    opacity: 0;
    transform: translate(-50%, -8px);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms ease;
  }

  .primary-site-header__item:hover > .primary-site-header__dropdown,
  .primary-site-header__item.is-open > .primary-site-header__dropdown {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .primary-site-header__dropdown::before {
    position: absolute;
    top: -12px;
    right: 0;
    left: 0;
    height: 14px;
    content: "";
  }

  .primary-site-header__dropdown--simple {
    display: grid;
    width: 286px;
    gap: 4px;
  }

  .primary-site-header__dropdown--right {
    right: 0;
    left: auto;
    transform: translate(0, -8px);
  }

  .primary-site-header__item:hover > .primary-site-header__dropdown--right,
  .primary-site-header__item.is-open > .primary-site-header__dropdown--right {
    transform: translate(0, 0);
  }

  .primary-site-header__dropdown-eyebrow {
    margin: 0 0 8px;
    padding: 0 10px 10px;
    border-bottom: 1px solid #e2edf2;
    color: #5c7380;
    font-size: 0.68rem;
    font-weight: 780;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .primary-site-header__dropdown--simple > a,
  .primary-site-header__treatment-flyout > a {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 9px 11px;
    border-radius: 10px;
    color: #0e384c !important;
    font-size: 0.88rem;
    font-weight: 680;
    line-height: 1.25;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }

  .primary-site-header__dropdown--simple > a:hover,
  .primary-site-header__dropdown--simple > a:focus-visible,
  .primary-site-header__dropdown--simple > a[aria-current="page"],
  .primary-site-header__treatment-flyout > a:hover,
  .primary-site-header__treatment-flyout > a:focus-visible,
  .primary-site-header__treatment-flyout > a[aria-current="page"] {
    background: #edf7fb;
    color: #1e84b5 !important;
    transform: translateX(3px);
  }

  .primary-site-header__dropdown--treatments {
    width: 330px;
    padding: 12px;
  }

  .primary-site-header__treatment-list {
    display: grid;
    gap: 2px;
  }

  .primary-site-header__all-treatments {
    display: grid;
    min-height: 58px;
    margin-bottom: 5px;
    padding: 10px 13px;
    border-radius: 12px;
    background: #eaf5fa;
    color: #0e384c !important;
    line-height: 1.2;
  }

  .primary-site-header__all-treatments span {
    font-size: 0.9rem;
    font-weight: 780;
  }

  .primary-site-header__all-treatments small {
    margin-top: 3px;
    color: #5c7380;
    font-size: 0.72rem;
    font-weight: 560;
  }

  .primary-site-header__treatment-group {
    position: relative;
  }

  body.brand-palette .primary-site-header .primary-site-header__treatment-group > button,
  .primary-site-header__treatment-group > button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    width: 100%;
    min-height: 46px;
    padding: 9px 12px;
    border-radius: 11px;
    color: #0e384c !important;
    cursor: pointer;
    gap: 12px;
    text-align: left;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .primary-site-header__treatment-group > button > span:first-child {
    font-size: 0.83rem;
    font-weight: 720;
    line-height: 1.25;
  }

  .primary-site-header__flyout-arrow {
    display: block;
    width: 7px;
    height: 7px;
    border-top: 1.7px solid currentColor;
    border-right: 1.7px solid currentColor;
    transform: rotate(45deg);
  }

  body.brand-palette .primary-site-header .primary-site-header__treatment-group:hover > button,
  body.brand-palette .primary-site-header .primary-site-header__treatment-group:focus-within > button,
  body.brand-palette .primary-site-header .primary-site-header__treatment-group.is-open > button,
  .primary-site-header__treatment-group:hover > button,
  .primary-site-header__treatment-group:focus-within > button,
  .primary-site-header__treatment-group.is-open > button {
    background: #edf7fb !important;
    color: #1e84b5 !important;
  }

  .primary-site-header__treatment-flyout {
    position: absolute;
    top: -12px;
