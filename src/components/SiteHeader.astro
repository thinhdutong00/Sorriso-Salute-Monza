    .primary-site-header *::before,
    .primary-site-header *::after {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>

<script>
  const initialisePrimarySiteHeader = () => {
    const header = document.querySelector<HTMLElement>("[data-primary-site-header]");
    if (!header || header.dataset.ready === "true") return;
    header.dataset.ready = "true";

    const dropdowns = Array.from(header.querySelectorAll<HTMLElement>("[data-header-dropdown]"));
    const mobileToggle = header.querySelector<HTMLButtonElement>("[data-header-mobile-toggle]");
    const mobileMenu = header.querySelector<HTMLElement>("[data-header-mobile-menu]");
    const desktopMedia = window.matchMedia("(min-width: 1240px)");
    let lastDesktopToggle: HTMLButtonElement | null = null;
    let lastScrollY = Math.max(0, window.scrollY || window.pageYOffset || 0);
    let scrollFrame = 0;

    const updateHeaderTone = (currentY = Math.max(0, window.scrollY || window.pageYOffset || 0)) => {
      header.classList.toggle(
        "is-floating",
        currentY > 0 && !header.classList.contains("is-mobile-open"),
      );

      if (
        !header.classList.contains("primary-site-header--overlay") ||
        header.classList.contains("is-mobile-open")
      ) {
        header.classList.add("is-scrolled");
        return;
      }

      header.classList.toggle("is-scrolled", currentY > 0);
    };

    const headerInteractionIsOpen = () =>
      header.classList.contains("is-mobile-open") ||
      dropdowns.some(
        (dropdown) =>
          dropdown.classList.contains("is-open") ||
          dropdown.matches(":hover") ||
          dropdown.matches(":focus-within"),
      );

    const updateHeader = () => {
      const currentY = Math.max(0, window.scrollY || window.pageYOffset || 0);
      const headerHeight = header.getBoundingClientRect().height || 92;
      const scrollingDown = currentY > lastScrollY + 6;
      const scrollingUp = currentY < lastScrollY - 6;

      updateHeaderTone(currentY);

      if (headerInteractionIsOpen() || currentY <= 12 || scrollingUp) {
        header.classList.remove("is-hidden");
      } else if (scrollingDown && currentY > headerHeight + 28) {
        header.classList.add("is-hidden");
      }

      lastScrollY = currentY;
      scrollFrame = 0;
    };

    const requestHeaderUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateHeader);
    };

    const closeDesktopDropdowns = (restoreFocus = false) => {
      dropdowns.forEach((dropdown) => {
        dropdown.classList.remove("is-open");
        dropdown
          .querySelector<HTMLButtonElement>("[data-header-dropdown-toggle]")
          ?.setAttribute("aria-expanded", "false");
        dropdown.querySelectorAll<HTMLElement>("[data-treatment-flyout]").forEach((flyout) => {
          flyout.classList.remove("is-open");
          flyout
            .querySelector<HTMLButtonElement>("[data-treatment-flyout-toggle]")
            ?.setAttribute("aria-expanded", "false");
        });
      });
      if (restoreFocus) lastDesktopToggle?.focus();
    };

    dropdowns.forEach((dropdown) => {
      const toggle = dropdown.querySelector<HTMLButtonElement>("[data-header-dropdown-toggle]");
      toggle?.addEventListener("click", (event) => {
        event.preventDefault();
        const willOpen = !dropdown.classList.contains("is-open");
        closeDesktopDropdowns();
        dropdown.classList.toggle("is-open", willOpen);
        toggle.setAttribute("aria-expanded", String(willOpen));
        if (willOpen) {
          lastDesktopToggle = toggle;
          header.classList.remove("is-hidden");
        }
      });

      dropdown.querySelectorAll<HTMLElement>("[data-treatment-flyout]").forEach((flyout) => {
        const flyoutToggle = flyout.querySelector<HTMLButtonElement>("[data-treatment-flyout-toggle]");
        flyoutToggle?.addEventListener("click", (event) => {
          event.preventDefault();
          const willOpen = !flyout.classList.contains("is-open");
          dropdown.querySelectorAll<HTMLElement>("[data-treatment-flyout]").forEach((otherFlyout) => {
            otherFlyout.classList.remove("is-open");
            otherFlyout
              .querySelector<HTMLButtonElement>("[data-treatment-flyout-toggle]")
              ?.setAttribute("aria-expanded", "false");
          });
          flyout.classList.toggle("is-open", willOpen);
          flyoutToggle.setAttribute("aria-expanded", String(willOpen));
        });
      });
    });

    const setMobileMenu = (isOpen: boolean) => {
      if (!mobileToggle || !mobileMenu) return;
      mobileToggle.setAttribute("aria-expanded", String(isOpen));
      mobileToggle.setAttribute(
        "aria-label",
        isOpen ? "Chiudi il menu di navigazione" : "Apri il menu di navigazione",
      );
      mobileMenu.hidden = !isOpen;
      header.classList.toggle("is-mobile-open", isOpen);
      document.body.classList.toggle("primary-site-menu-open", isOpen);
      if (isOpen) {
        header.classList.remove("is-hidden");
        closeDesktopDropdowns();
        mobileMenu.querySelector<HTMLElement>("summary, a")?.focus({ preventScroll: true });
      }
      updateHeaderTone();
    };

    mobileToggle?.addEventListener("click", () => {
      setMobileMenu(mobileToggle.getAttribute("aria-expanded") !== "true");
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMobileMenu(false));
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node) || header.contains(event.target)) return;
      closeDesktopDropdowns();
      setMobileMenu(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const mobileWasOpen = mobileToggle?.getAttribute("aria-expanded") === "true";
      closeDesktopDropdowns(true);
      setMobileMenu(false);
      if (mobileWasOpen) mobileToggle?.focus();
    });

    desktopMedia.addEventListener("change", ({ matches }) => {
      if (matches) setMobileMenu(false);
      else closeDesktopDropdowns();
      requestHeaderUpdate();
    });

    updateHeader();
    window.addEventListener("scroll", requestHeaderUpdate, { passive: true });
    window.addEventListener("resize", requestHeaderUpdate);
    window.addEventListener("load", updateHeader);
  };

  initialisePrimarySiteHeader();
  document.addEventListener("astro:page-load", initialisePrimarySiteHeader);
</script>
