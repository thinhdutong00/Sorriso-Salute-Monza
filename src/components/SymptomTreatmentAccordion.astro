---
import type { SymptomRoutingTreatment } from "../data/symptomRoutingPages";

type Props = {
  treatment: SymptomRoutingTreatment;
};

const { treatment } = Astro.props;
const summaryId = `symptom-treatment-${treatment.serviceSlug}-summary`;
const panelId = `symptom-treatment-${treatment.serviceSlug}-panel`;
---

<details class="symptom-treatment-accordion" data-symptom-treatment-accordion>
  <summary
    id={summaryId}
    aria-expanded="false"
    aria-controls={panelId}
  >
    <span>{treatment.label}</span>
    <span class="symptom-treatment-accordion__indicator" aria-hidden="true"></span>
  </summary>

  <div
    class="symptom-treatment-accordion__panel"
    id={panelId}
    role="region"
    aria-labelledby={summaryId}
  >
    <p>{treatment.description}</p>
    <div class="symptom-treatment-accordion__actions">
      <a
        class="site-button symptom-treatment-accordion__button"
        href={treatment.bookingHref}
      >
        Prenota una visita
      </a>
      <a
        class="site-button symptom-treatment-accordion__button symptom-treatment-accordion__button--secondary"
        href={treatment.treatmentHref}
      >
        Vai alla pagina
      </a>
    </div>
  </div>
</details>

<script>
  const initializeSymptomTreatmentAccordions = () => {
    document
      .querySelectorAll<HTMLDetailsElement>("[data-symptom-treatment-accordion]")
      .forEach((details) => {
        if (details.dataset.accordionReady === "true") return;

        const summary = details.querySelector<HTMLElement>("summary");
        if (!summary) return;

        const syncExpandedState = () => {
          summary.setAttribute("aria-expanded", String(details.open));
        };

        details.dataset.accordionReady = "true";
        details.addEventListener("toggle", syncExpandedState);
        syncExpandedState();
      });
  };

  initializeSymptomTreatmentAccordions();
  document.addEventListener(
    "astro:page-load",
    initializeSymptomTreatmentAccordions,
  );
</script>

<style>
  .symptom-treatment-accordion {
    overflow: hidden;
    border: 1px solid rgba(14, 56, 76, 0.11);
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 14px 38px rgba(14, 56, 76, 0.07);
    color: var(--brand-primary, #0e384c);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .symptom-treatment-accordion[open] {
    border-color: rgba(30, 132, 181, 0.28);
    box-shadow: 0 20px 48px rgba(14, 56, 76, 0.1);
  }

  .symptom-treatment-accordion summary {
    display: flex;
    min-height: 82px;
    align-items: center;
    justify-content: space-between;
    padding: 22px clamp(20px, 3vw, 30px);
    gap: 24px;
    color: var(--brand-primary, #0e384c);
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    font-weight: 760;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .symptom-treatment-accordion summary::-webkit-details-marker {
    display: none;
  }

  .symptom-treatment-accordion summary:hover {
    background: rgba(217, 236, 244, 0.22);
    color: var(--brand-secondary, #1e84b5);
  }

  .symptom-treatment-accordion summary:focus-visible {
    border-radius: 18px;
    outline: 3px solid rgba(30, 132, 181, 0.32);
    outline-offset: -5px;
  }

  .symptom-treatment-accordion__indicator {
    position: relative;
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    border: 1px solid rgba(30, 132, 181, 0.34);
    border-radius: 50%;
    color: var(--brand-secondary, #1e84b5);
  }

  .symptom-treatment-accordion__indicator::before,
  .symptom-treatment-accordion__indicator::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    content: "";
    transform: translate(-50%, -50%);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .symptom-treatment-accordion__indicator::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .symptom-treatment-accordion[open]
    .symptom-treatment-accordion__indicator::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(0);
  }

  .symptom-treatment-accordion__panel {
    padding: 0 clamp(20px, 3vw, 30px) clamp(26px, 3vw, 34px);
    border-top: 1px solid rgba(14, 56, 76, 0.08);
  }

  .symptom-treatment-accordion__panel p {
    max-width: 820px;
    margin: clamp(22px, 3vw, 28px) 0 0;
    color: var(--color-text-description, #334155);
    font-size: clamp(1rem, 1.35vw, 1.08rem);
    line-height: 1.7;
  }

  .symptom-treatment-accordion__actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: 24px;
    gap: 12px;
  }

  .symptom-treatment-accordion__button {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    padding: 0 24px;
    border: 1px solid var(--brand-primary, #0e384c);
    border-radius: var(--site-button-radius, 14px);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  :global(body.brand-palette)
    .symptom-treatment-accordion__button--secondary {
    --site-button-base-fill: #fff;
    --site-button-base-color: var(--brand-primary, #0e384c);
    --site-button-base-border: rgba(14, 56, 76, 0.18);
    --site-button-hover-fill: var(--brand-secondary, #1e84b5);
    --site-button-hover-color: #fff;
    --site-button-hover-border: var(--brand-secondary, #1e84b5);
  }

  @media (max-width: 560px) {
    .symptom-treatment-accordion summary {
      min-height: 74px;
      padding: 19px 18px;
      gap: 16px;
    }

    .symptom-treatment-accordion__panel {
      padding: 0 18px 24px;
    }

    .symptom-treatment-accordion__actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .symptom-treatment-accordion__button {
      width: 100%;
      padding-right: 18px;
      padding-left: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .symptom-treatment-accordion,
    .symptom-treatment-accordion summary,
    .symptom-treatment-accordion__indicator::before,
    .symptom-treatment-accordion__indicator::after {
      transition: none;
    }
  }
</style>
