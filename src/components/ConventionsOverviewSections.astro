---
const financingPartners = [
  {
    name: "Compass",
    href: "https://www.compass.it/",
    image: "/mirror-assets/e0897a7e12ecd85f.png",
    width: 300,
    height: 61,
  },
  {
    name: "HeyLight",
    href: "https://heylight.com/it/it",
    image: "/mirror-assets/0626212863161494.png",
    width: 197,
    height: 87,
  },
];

const conventionGroups = [
  {
    title: "Convenzioni dirette",
    description:
      "Lo Studio è convenzionato in forma diretta con i maggiori fondi sanitari, casse mutue e assicurazioni",
    href: "/convenzioni-dirette/",
    logos: [
      { image: "/mirror-assets/a209315cb5ad2a68.jpg", name: "Assirecre Group" },
      { image: "/mirror-assets/b88ede980f84aa4e.jpg", name: "Caspie" },
      { image: "/mirror-assets/1c4890089f5b77fa.jpg", name: "Coop Salute" },
      { image: "/mirror-assets/ad934b9b80100379.jpg", name: "Faschim" },
      { image: "/mirror-assets/d5bc56b7ef3d28d8.jpg", name: "Fasi" },
      { image: "/mirror-assets/bdd6860198830913.jpg", name: "Fisde" },
      { image: "/mirror-assets/6f510fb0229b612c.jpg", name: "Mapfre" },
      { image: "/mirror-assets/e5262a8625945e83.png", name: "Previmedical" },
      { image: "/mirror-assets/1c0b9a6a2db70da5.png", name: "UniSalute" },
      { image: "/mirror-assets/2f3e7a9c5b324b90.png", name: "Health Assistance" },
    ],
  },
  {
    title: "Convenzioni indirette",
    description:
      "Lo Studio è convenzionato in forma indiretta con i maggiori fondi sanitari, casse mutue e assicurazioni",
    href: "/convenzioni-indirette/",
    logos: [
      { image: "/mirror-assets/49fdb4e25cdfaab6.jpg", name: "ADE" },
      { image: "/mirror-assets/add3c13f653d2746.jpg", name: "Insieme Salute" },
      { image: "/mirror-assets/a533a031656e442f.jpg", name: "WinSalute" },
      { image: "/mirror-assets/1bb53ded6768d537.jpg", name: "ALDAI" },
      { image: "/mirror-assets/f9547adb6e817a3e.jpg", name: "Assilt" },
      { image: "/mirror-assets/20d8833ec1224f55.jpg", name: "Odontonetwork" },
      { image: "/mirror-assets/5609e406af400606.jpg", name: "Fondo Salute" },
    ],
  },
];
---

<section class="financing-overview" aria-labelledby="financing-overview-title">
  <div class="financing-overview__inner">
    <div class="financing-overview__content">
      <p class="financing-overview__eyebrow">Le nostre finanziarie</p>
      <h1 id="financing-overview-title">I nostri servizi di finanziamento personalizzati</h1>
      <p class="financing-overview__description">
        Il nostro Studio Odontoiatrico offre <strong>soluzioni di finanziamento personalizzate</strong> pensate per
        rendere le cure dentistiche più accessibili, senza rinunciare alla qualità dei trattamenti.
      </p>
    </div>

    <div class="financing-overview__partners" aria-label="Finanziarie partner">
      {
        financingPartners.map((partner) => (
          <a
            class="financing-overview__partner"
            href={partner.href}
            aria-label={`Visita il sito di ${partner.name}`}
          >
            <img
              src={partner.image}
              alt={partner.name}
              width={partner.width}
              height={partner.height}
              loading="eager"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="convention-groups" aria-label="Convenzioni dello studio">
  {
    conventionGroups.map((group) => (
      <article class="convention-group">
        <div class="convention-group__heading">
          <h2>{group.title}</h2>
          <p>{group.description}</p>
        </div>

        <div
          class="convention-group__logos"
          aria-label={`Loghi delle ${group.title.toLowerCase()}`}
          tabindex="0"
        >
          {group.logos.map((logo) => (
            <div class="convention-group__logo">
              <img src={logo.image} alt={logo.name} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>

        <a class="convention-group__button" href={group.href}>
          <span>Tutte le convenzioni</span>
          <svg aria-hidden="true" viewBox="0 0 16 14" width="18" height="16" fill="none">
            <path
              d="M1 7h14m0 0L9 1m6 6-6 6"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </article>
    ))
  }
</section>

<style>
  .financing-overview,
  .financing-overview *,
  .financing-overview *::before,
  .financing-overview *::after,
  .convention-groups,
  .convention-groups *,
  .convention-groups *::before,
  .convention-groups *::after {
    box-sizing: border-box;
  }

  .financing-overview,
  .convention-groups {
    width: 100%;
    font-family: var(--brand-font-family, var(--font-family-body));
  }

  .financing-overview {
    padding:
      clamp(158px, 12vw, 196px)
      clamp(18px, 3vw, 48px)
      clamp(80px, 7vw, 120px);
    background: #ffffff;
    color: var(--brand-primary, #0e384c);
  }

  .financing-overview__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    align-items: center;
    width: min(1500px, 100%);
    margin: 0 auto;
    gap: clamp(52px, 6vw, 110px);
  }

  .financing-overview__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 660px;
  }

  .financing-overview__eyebrow {
    position: relative;
    margin: 0 0 26px;
    padding-left: 28px;
    color: var(--brand-secondary, #1e84b5);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .financing-overview__eyebrow::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    height: 18px;
    background: var(--brand-secondary, #1e84b5);
    content: "";
    transform: translateY(-50%);
    -webkit-mask: url("/mirror-assets/2829794763d559b4.svg") center / contain no-repeat;
    mask: url("/mirror-assets/2829794763d559b4.svg") center / contain no-repeat;
  }

  .financing-overview h1 {
    max-width: 660px;
    margin: 0 0 24px;
    color: var(--brand-secondary, #1e84b5);
    font-family: var(--font-family-display, var(--brand-font-family));
    font-size: clamp(48px, 4vw, 60px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .financing-overview__description {
    max-width: 640px;
    margin: 0;
    color: var(--color-text-description, #334155);
    font-size: clamp(18px, 1.35vw, 22px);
    font-weight: 400;
    line-height: 1.52;
  }

  .financing-overview__description strong {
    color: inherit;
    font-weight: 700;
  }

  .financing-overview__partners {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
    max-width: 720px;
    gap: clamp(18px, 2.2vw, 34px);
  }

  .financing-overview__partner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: clamp(28px, 4vw, 58px);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border: 1px solid rgba(30, 132, 181, 0.18);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 18px 44px rgba(14, 56, 76, 0.08);
  }

  .financing-overview__partner img {
    width: 100%;
    height: auto;
    max-height: 72%;
    object-fit: contain;
    transition: transform 180ms ease;
  }

  .financing-overview__partner:is(:hover, :focus-visible) img {
    transform: scale(1.035);
  }

  .financing-overview__partner:focus-visible,
  .convention-group__button:focus-visible,
  .convention-group__logos:focus-visible {
    outline: 3px solid var(--brand-secondary, #1e84b5);
    outline-offset: 4px;
  }

  .convention-groups {
    padding: clamp(34px, 3vw, 52px) clamp(18px, 3vw, 48px) clamp(94px, 8vw, 138px);
    background: #ffffff;
  }

  .convention-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(1420px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  .convention-group + .convention-group {
    margin-top: clamp(96px, 9vw, 150px);
  }

  .convention-group__heading {
    width: min(950px, 100%);
  }

  .convention-group__heading h2 {
    margin: 0 0 20px;
    color: #111827;
    font-family: var(--font-family-display, var(--brand-font-family));
    font-size: clamp(48px, 4.3vw, 68px);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .convention-group__heading p {
    max-width: 900px;
    margin: 0 auto;
    color: var(--color-text-description, #334155);
    font-size: clamp(18px, 1.35vw, 22px);
    line-height: 1.52;
    text-wrap: balance;
  }

  .convention-group__logos {
    display: grid;
    grid-auto-columns: calc((100% - 96px) / 3);
    grid-auto-flow: column;
    width: 100%;
    margin: clamp(52px, 5vw, 78px) 0 clamp(46px, 4vw, 68px);
    padding: 0 2px 8px;
    gap: 48px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }

  .convention-group__logos::-webkit-scrollbar {
    display: none;
  }

  .convention-group__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: clamp(150px, 13vw, 205px);
    scroll-snap-align: start;
  }

  .convention-group__logo img {
    display: block;
    width: min(100%, 320px);
    height: min(100%, 120px);
    object-fit: contain;
  }

  .convention-group__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 28px;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--brand-primary, #0e384c);
    border-radius: var(--site-button-radius, 14px);
    background: var(--brand-primary, #0e384c);
    color: #ffffff !important;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 14px 30px rgba(14, 56, 76, 0.18);
    gap: 18px;
  }

  .convention-group__button::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #ffffff;
    content: "";
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 280ms ease;
  }

  .convention-group__button:is(:hover, :focus-visible) {
    border-color: var(--brand-secondary, #1e84b5);
    color: var(--brand-secondary, #1e84b5) !important;
  }

  .convention-group__button:is(:hover, :focus-visible)::before {
    transform: scaleX(1);
  }

  .convention-group__button svg {
    flex: 0 0 auto;
    transition: transform 180ms ease;
  }

  .convention-group__button:is(:hover, :focus-visible) svg {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .financing-overview {
      padding-top: clamp(138px, 17vw, 170px);
    }

    .financing-overview__inner {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .financing-overview__content,
    .financing-overview__partners {
      max-width: 100%;
    }

    .convention-group__logos {
      grid-auto-columns: calc((100% - 40px) / 3);
      gap: 20px;
    }
  }

  @media (max-width: 767px) {
    .financing-overview {
      padding: 124px 18px 70px;
      background: var(--brand-primary, #0e384c);
    }

    .financing-overview__eyebrow,
    .financing-overview h1,
    .financing-overview__description,
    .financing-overview__description strong {
      color: #ffffff;
    }

    .financing-overview__eyebrow {
      margin-bottom: 20px;
      font-size: 12px;
      line-height: 1.35;
    }

    .financing-overview__eyebrow::before {
      background: #ffffff;
    }

    .financing-overview h1 {
      margin-bottom: 20px;
      font-size: clamp(31px, 9vw, 40px);
      line-height: 1.08;
      letter-spacing: -0.025em;
    }

    .financing-overview__description {
      font-size: 17px;
      line-height: 1.55;
    }

    .financing-overview__partners {
      gap: 14px;
    }

    .financing-overview__partner {
      padding: 20px;
    }

    .convention-groups {
      padding: 70px 18px 86px;
    }

    .convention-group + .convention-group {
      margin-top: 92px;
    }

    .convention-group__heading h2 {
      margin-bottom: 16px;
      font-size: clamp(36px, 11vw, 48px);
    }

    .convention-group__heading p {
      font-size: 17px;
      line-height: 1.55;
    }

    .convention-group__logos {
      grid-auto-columns: min(82vw, 300px);
      margin: 38px 0 40px;
      gap: 18px;
    }

    .convention-group__logo {
      height: 150px;
    }

    .convention-group__button {
      min-height: 56px;
      padding: 0 24px;
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .financing-overview__partner img,
    .convention-group__button::before,
    .convention-group__button svg {
      transition: none;
    }
  }
</style>
