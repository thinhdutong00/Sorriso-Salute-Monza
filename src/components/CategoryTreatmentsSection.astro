---
import {
  buildTreatmentRequestHref,
  type CategoryTreatmentsData,
} from "../data/categoryTreatments";

type Props = CategoryTreatmentsData;

const {
  eyebrow = "I trattamenti",
  title,
  description,
  groups,
  sectionId,
  formService,
} = Astro.props;
const titleId = `${sectionId}-title`;
const gridId = `${sectionId}-grid`;
const mobileTreatmentLimit = 4;

let treatmentIndex = 0;
const indexedGroups = groups.map((group) => ({
  ...group,
  items: group.items.map((item) => ({ item, index: treatmentIndex++ })),
}));
const hasMobileOverflow = treatmentIndex > mobileTreatmentLimit;
---

<section
  class="category-treatments"
  id={sectionId}
  aria-labelledby={titleId}
  data-category-treatments
>
  <div class="category-treatments__container">
    <header class="category-treatments__heading">
      <p class="category-treatments__eyebrow">{eyebrow}</p>
      <h2 id={titleId}>{title}</h2>
      {description && <p class="category-treatments__description">{description}</p>}
    </header>

    <div class="category-treatments__grid" id={gridId}>
      {
        indexedGroups.map((group, index) => {
          const groupTitleId = `${sectionId}-group-${index + 1}`;
          const isInitiallyHiddenOnMobile = group.items.every(
            ({ index: itemIndex }) => itemIndex >= mobileTreatmentLimit,
          );

          return (
            <section
              class:list={[
                "category-treatments__group",
                {
                  "category-treatments__group--mobile-overflow":
                    isInitiallyHiddenOnMobile,
                },
              ]}
              aria-labelledby={groupTitleId}
            >
              <h3 id={groupTitleId}>{group.title}</h3>
              <ul>
                {group.items.map(({ item, index: itemIndex }) => (
                  <>
                    <li
                      class:list={[
                        "category-treatments__item",
                        {
                          "category-treatments__item--mobile-overflow":
                            itemIndex >= mobileTreatmentLimit,
                        },
                      ]}
                    >
                      <details>
                        <summary>
                          <span class="category-treatments__item-label">{item.label}</span>
                          <span class="category-treatments__indicator" aria-hidden="true">+</span>
                        </summary>
                        <div class="category-treatments__panel">
                          <p>{item.description}</p>
                          <div class="category-treatments__actions">
                            {item.internalHref && (
                              <a href={item.internalHref}>Approfondisci</a>
                            )}
                            <a href={buildTreatmentRequestHref(formService.slug, item.id)}>
                              Richiedi visita
                            </a>
                          </div>
                        </div>
                      </details>
                    </li>

                    {hasMobileOverflow && itemIndex === mobileTreatmentLimit - 1 && (
                      <li class="category-treatments__reveal-item">
                        <button
                          type="button"
                          aria-controls={gridId}
                          aria-expanded="false"
                          data-treatments-reveal
                        >
                          Scopri tutti i trattamenti
                        </button>
                      </li>
                    )}
                  </>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const enhanceCategoryTreatments = () => {
    document
      .querySelectorAll<HTMLElement>("[data-category-treatments]")
      .forEach((section) => {
        if (section.dataset.treatmentsEnhanced === "true") return;

        const revealButton = section.querySelector<HTMLButtonElement>(
          "[data-treatments-reveal]",
        );
        if (!revealButton) return;

        section.dataset.treatmentsEnhanced = "true";
        section.classList.add("is-enhanced");

        revealButton.addEventListener("click", () => {
          const firstRevealedSummary = section.querySelector<HTMLElement>(
            ".category-treatments__item--mobile-overflow summary",
          );

          section.classList.add("is-mobile-expanded");
          revealButton.setAttribute("aria-expanded", "true");
          firstRevealedSummary?.focus();
        });
      });
  };

  enhanceCategoryTreatments();
  document.addEventListener("astro:page-load", enhanceCategoryTreatments);
</script>

<style>
  .category-treatments {
    padding: clamp(72px, 8vw, 104px) 24px;
    border-top: 1px solid rgba(14, 56, 76, 0.08);
    border-bottom: 1px solid rgba(14, 56, 76, 0.08);
    background: #f8fafc;
    color: var(--brand-primary, #0e384c);
  }

  .category-treatments__container {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .category-treatments__heading {
    max-width: 850px;
    margin-bottom: clamp(42px, 5vw, 62px);
  }

  .category-treatments__eyebrow {
    display: flex;
    align-items: center;
    margin: 0 0 20px;
    gap: 14px;
    color: var(--brand-secondary, #1e84b5);
    font-size: clamp(0.68rem, 0.85vw, 0.76rem);
    font-weight: 850;
    letter-spacing: 0.16em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .category-treatments__eyebrow::before {
    width: clamp(34px, 4vw, 52px);
    height: 1px;
    flex: 0 0 auto;
    background: currentColor;
    content: "";
  }

  .category-treatments__heading h2 {
    margin: 0;
    color: var(--brand-primary, #0e384c);
    font-size: clamp(2.35rem, 4.8vw, 4.3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .category-treatments__description {
    max-width: 760px;
    margin: 24px 0 0;
    color: var(--color-text-description, #334155);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.65;
  }

  .category-treatments__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(38px, 5vw, 64px) clamp(42px, 7vw, 86px);
  }

  .category-treatments__group {
    min-width: 0;
    padding-top: 22px;
    border-top: 1px solid rgba(14, 56, 76, 0.16);
  }

  .category-treatments__group h3 {
    margin: 0 0 18px;
    color: var(--brand-primary, #0e384c);
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .category-treatments__group ul {
    display: grid;
    margin: 0;
    padding: 0;
    gap: 11px;
    list-style: none;
  }

  .category-treatments__item {
    position: relative;
    min-width: 0;
    padding-left: 18px;
    color: var(--color-text-description, #334155);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .category-treatments__item::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand-secondary, #1e84b5);
    content: "";
  }

  .category-treatments__item details,
  .category-treatments__item summary {
    min-width: 0;
  }

  .category-treatments__item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    color: var(--brand-primary, #0e384c);
    font-weight: 680;
    list-style: none;
    cursor: pointer;
  }

  .category-treatments__item summary::-webkit-details-marker {
    display: none;
  }

  .category-treatments__item-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .category-treatments__indicator {
    width: 1.2em;
    flex: 0 0 1.2em;
    color: var(--brand-secondary, #1e84b5);
    font-size: 1.15em;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    transform-origin: center;
    transition: transform 160ms ease;
  }

  .category-treatments__item details[open] .category-treatments__indicator {
    transform: rotate(45deg);
  }

  .category-treatments__item summary:hover {
    color: var(--brand-secondary, #1e84b5);
  }

  .category-treatments__item summary:focus-visible,
  .category-treatments__group a:focus-visible,
  .category-treatments__reveal-item button:focus-visible {
    border-radius: 3px;
    outline: 3px solid rgba(30, 132, 181, 0.28);
    outline-offset: 4px;
  }

  .category-treatments__panel {
    padding: 10px 32px 5px 0;
  }

  .category-treatments__panel p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .category-treatments__actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: 12px;
    gap: 8px 18px;
  }

  .category-treatments__group a {
    color: var(--brand-primary, #0e384c);
    font-weight: 680;
    text-decoration: underline;
    text-decoration-color: rgba(30, 132, 181, 0.38);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .category-treatments__group a:hover,
  .category-treatments__group a:focus-visible {
    color: var(--brand-secondary, #1e84b5);
    text-decoration-color: currentColor;
  }

  .category-treatments__reveal-item {
    display: none;
    padding: 5px 0 0;
  }

  .category-treatments__reveal-item button {
    width: 100%;
    padding: 12px 18px;
    border: 1px solid rgba(30, 132, 181, 0.45);
    border-radius: 999px;
    background: transparent;
    color: var(--brand-primary, #0e384c);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
  }

  .category-treatments__reveal-item button:hover {
    border-color: var(--brand-secondary, #1e84b5);
    background: rgba(30, 132, 181, 0.06);
    color: var(--brand-secondary, #1e84b5);
  }

  @media (max-width: 767px) {
    .category-treatments {
      padding: 64px 18px;
    }

    .category-treatments__heading {
      margin-bottom: 38px;
    }

    .category-treatments__eyebrow {
      margin-bottom: 16px;
      gap: 10px;
      letter-spacing: 0.13em;
    }

    .category-treatments__eyebrow::before {
      width: 28px;
    }

    .category-treatments__heading h2 {
      font-size: clamp(2.05rem, 10vw, 2.75rem);
      line-height: 1.06;
    }

    .category-treatments__description {
      margin-top: 18px;
      font-size: 1rem;
      line-height: 1.6;
    }

    .category-treatments__grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .category-treatments__group {
      padding-top: 18px;
    }

    .category-treatments__group h3 {
      margin-bottom: 16px;
    }

    .category-treatments__group ul {
      gap: 12px;
    }

    .category-treatments.is-enhanced:not(.is-mobile-expanded)
      .category-treatments__group--mobile-overflow,
    .category-treatments.is-enhanced:not(.is-mobile-expanded)
      .category-treatments__item--mobile-overflow {
      display: none;
    }

    .category-treatments.is-enhanced:not(.is-mobile-expanded)
      .category-treatments__reveal-item {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-treatments__indicator,
    .category-treatments__group a,
    .category-treatments__reveal-item button {
      transition: none;
    }
  }
</style>
