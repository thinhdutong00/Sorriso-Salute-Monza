---
import "../styles/global.css";
import BrandPalette from "./BrandPalette.astro";
import FaviconLinks from "./FaviconLinks.astro";
import GoogleAdsTracking from "./GoogleAdsTracking.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import SymptomTreatmentAccordion from "./SymptomTreatmentAccordion.astro";
import type { SymptomRoutingPage } from "../data/symptomRoutingPages";

type Props = {
  page: SymptomRoutingPage;
};

const { page } = Astro.props;
const canonicalUrl = `https://sorrisoesalutemonza.it${page.path}`;
const pageTitleId = `symptom-title-${page.slug}`;
const optionsTitleId = `symptom-options-${page.slug}`;
const finalCtaTitleId = `symptom-final-cta-${page.slug}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={page.metaDescription} />
    <meta name="theme-color" content="#0E384C" />
    <link rel="canonical" href={canonicalUrl} />
    <FaviconLinks />
    <GoogleAdsTracking />
    <BrandPalette />
    <title>{page.title} | Sorriso & Salute Monza</title>
  </head>
  <body class="brand-palette internal-page symptom-routing-page">
    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <section
        class="symptom-routing-options"
        aria-labelledby={pageTitleId}
      >
        <div class="symptom-routing-options__container">
          <nav
            class="symptom-routing-breadcrumb"
            aria-label="Percorso di navigazione"
          >
            <ol>
              <li><a href="/">Home</a></li>
              <li aria-current="page"><span>{page.title}</span></li>
            </ol>
          </nav>

          <header class="symptom-routing-options__heading">
            <p class="symptom-routing-options__eyebrow">Possibili aree</p>
            <h1 id={pageTitleId}>{page.title}</h1>

            <div class="symptom-routing-options__guide">
              <h2 id={optionsTitleId}>Da quale trattamento iniziare?</h2>
              <p>
                Apri ogni voce per leggere una spiegazione breve, prenotare una
                visita o consultare la pagina completa del trattamento.
              </p>
            </div>
          </header>

          <div class="symptom-routing-options__list">
            {
              page.treatments.map((treatment) => (
                <SymptomTreatmentAccordion treatment={treatment} />
              ))
            }
          </div>

          <p class="symptom-routing-options__note">
            Queste indicazioni servono solo a orientarti: il trattamento più
            adatto viene definito dopo una valutazione professionale.
          </p>
        </div>
      </section>

      <section
        class="symptom-routing-final-cta"
        aria-labelledby={finalCtaTitleId}
      >
        <div class="symptom-routing-final-cta__container">
          <p class="symptom-routing-final-cta__eyebrow">Il prossimo passo</p>
          <h2 id={finalCtaTitleId}>
            Non sai quale trattamento è meglio per il tuo caso?
          </h2>
          <p class="symptom-routing-final-cta__description">
            Raccontaci cosa senti: durante la visita valuteremo la situazione e
            ti indicheremo il percorso più adatto.
          </p>
          <a
            class="site-button symptom-routing-final-cta__button"
            data-site-button
            href="/richiesta-generale/"
          >
            Prenota una visita
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  .symptom-routing-breadcrumb {
    margin: 0;
    padding-bottom: clamp(64px, 7vw, 96px);
    color: var(--color-text-description, #64748b);
  }

  .symptom-routing-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    line-height: 1.45;
    gap: 10px;
  }

  .symptom-routing-breadcrumb li {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    overflow-wrap: anywhere;
    gap: 10px;
  }

  .symptom-routing-breadcrumb li:not(:last-child)::after {
    color: color-mix(in srgb, currentColor 58%, transparent);
    content: "\203A";
  }

  .symptom-routing-breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .symptom-routing-breadcrumb a:is(:hover, :focus-visible),
  .symptom-routing-breadcrumb li[aria-current="page"] {
    color: var(--brand-primary, #0e384c);
  }

  .symptom-routing-breadcrumb li[aria-current="page"] {
    font-weight: 700;
  }

  .symptom-routing-breadcrumb a:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--brand-secondary, #1e84b5);
    outline-offset: 3px;
  }

  .symptom-routing-options {
    padding:
      calc(var(--primary-site-header-height, 98px) + clamp(24px, 3vw, 38px))
      24px clamp(68px, 8vw, 106px);
    background:
      radial-gradient(
        circle at 96% 8%,
        rgba(217, 236, 244, 0.42),
        transparent 29rem
      ),
      #fff;
    color: var(--brand-primary, #0e384c);
  }

  .symptom-routing-options__container {
    width: min(1280px, 100%);
    margin: 0 auto;
  }

  .symptom-routing-options__heading {
    max-width: 900px;
    margin-bottom: clamp(36px, 5vw, 52px);
  }

  .symptom-routing-options__eyebrow {
    display: flex;
    align-items: center;
    margin: 0 0 20px;
    gap: 14px;
    color: var(--brand-secondary, #1e84b5);
    font-size: 0.75rem;
    font-weight: 850 !important;
    letter-spacing: 0.18em !important;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .symptom-routing-options__eyebrow::before {
    width: 46px;
    height: 1px;
    flex: 0 0 auto;
    background: currentColor;
    content: "";
  }

  .symptom-routing-options__heading h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--brand-primary, #0e384c) !important;
    font-size: clamp(3.6rem, 6.6vw, 6.35rem) !important;
    font-weight: 700 !important;
    letter-spacing: -0.05em !important;
    line-height: 0.96 !important;
    text-wrap: balance;
  }

  .symptom-routing-options__guide {
    max-width: 690px;
    margin-top: clamp(38px, 5vw, 58px);
  }

  .symptom-routing-options__guide h2 {
    margin: 0;
    color: var(--brand-primary, #0e384c) !important;
    font-size: clamp(1.75rem, 3vw, 2.6rem) !important;
    font-weight: 700 !important;
    letter-spacing: -0.03em !important;
    line-height: 1.08 !important;
    text-wrap: balance;
  }

  .symptom-routing-options__guide p {
    margin: 20px 0 0;
    color: var(--color-text-description, #334155);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
  }

  .symptom-routing-options__list {
    display: grid;
    width: min(1040px, 100%);
    gap: 16px;
  }

  .symptom-routing-options__note {
    max-width: 780px;
    margin: 30px 0 0;
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .symptom-routing-final-cta {
    position: relative;
    overflow: hidden;
    padding: clamp(88px, 9vw, 136px) 24px;
    background: linear-gradient(135deg, #082a38, #0e384c 62%, #155a66);
    color: #fff;
    text-align: center;
    isolation: isolate;
  }

  .symptom-routing-final-cta::before,
  .symptom-routing-final-cta::after {
    position: absolute;
    z-index: -1;
    width: 380px;
    height: 380px;
    border: 1px solid rgba(86, 184, 239, 0.2);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .symptom-routing-final-cta::before {
    top: -230px;
    left: -120px;
  }

  .symptom-routing-final-cta::after {
    right: -150px;
    bottom: -255px;
  }

  .symptom-routing-final-cta__container {
    width: min(1280px, 100%);
    margin: 0 auto;
  }

  .symptom-routing-final-cta__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 22px;
    color: #56b8ef;
    font-size: 0.75rem;
    font-weight: 850 !important;
    letter-spacing: 0.2em !important;
    line-height: 1.4;
    text-transform: uppercase;
    gap: 14px;
  }

  .symptom-routing-final-cta__eyebrow::before,
  .symptom-routing-final-cta__eyebrow::after {
    width: 38px;
    height: 1px;
    background: currentColor;
    content: "";
  }

  .symptom-routing-final-cta h2 {
    max-width: 18ch;
    margin: 0 auto;
    color: #fff !important;
    font-size: clamp(2.7rem, 5.2vw, 4.9rem) !important;
    font-weight: 700 !important;
    letter-spacing: -0.05em !important;
    line-height: 0.98 !important;
    text-wrap: balance;
  }

  .symptom-routing-final-cta__description {
    max-width: 710px;
    margin: 26px auto 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    line-height: 1.72;
  }

  .symptom-routing-final-cta__button {
    --site-button-base-fill: #fff !important;
    --site-button-base-color: var(--brand-primary, #0e384c) !important;
    --site-button-base-border: #fff !important;
    --site-button-hover-fill: var(--brand-secondary, #1e84b5) !important;
    --site-button-hover-color: #fff !important;
    --site-button-hover-border: var(--brand-secondary, #1e84b5) !important;
    display: inline-flex;
    min-height: 56px;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    padding: 16px 28px;
    font-size: 0.94rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 680px) {
    .symptom-routing-breadcrumb {
      padding-bottom: 52px;
    }

    .symptom-routing-breadcrumb ol {
      font-size: 0.78rem;
      gap: 7px;
    }

    .symptom-routing-breadcrumb li {
      gap: 7px;
    }

    .symptom-routing-options {
      padding:
        calc(var(--primary-site-header-height, 84px) + 20px)
        18px 72px;
    }

    .symptom-routing-options__heading {
      margin-bottom: 32px;
    }

    .symptom-routing-options__eyebrow {
      margin-bottom: 16px;
      gap: 10px;
      letter-spacing: 0.14em !important;
    }

    .symptom-routing-options__eyebrow::before {
      width: 30px;
    }

    .symptom-routing-options__heading h1 {
      max-width: 100%;
      font-size: clamp(3rem, 15vw, 4.1rem) !important;
    }

    .symptom-routing-options__guide {
      margin-top: 34px;
    }

    .symptom-routing-options__guide h2 {
      font-size: clamp(1.65rem, 8vw, 2.15rem) !important;
    }

    .symptom-routing-options__guide p {
      margin-top: 16px;
      font-size: 1rem;
    }

    .symptom-routing-options__note {
      margin-top: 26px;
    }

    .symptom-routing-final-cta {
      padding: 76px 18px 82px;
    }

    .symptom-routing-final-cta h2 {
      max-width: 100%;
      font-size: clamp(2.35rem, 11vw, 3.35rem) !important;
    }

    .symptom-routing-final-cta__description {
      margin-top: 22px;
      font-size: 1rem;
    }

    .symptom-routing-final-cta__eyebrow {
      margin-bottom: 18px;
      letter-spacing: 0.16em !important;
      gap: 10px;
    }

    .symptom-routing-final-cta__eyebrow::before,
    .symptom-routing-final-cta__eyebrow::after {
      width: 24px;
    }

    .symptom-routing-final-cta__button {
      width: min(100%, 360px);
      white-space: normal;
    }
  }
</style>
