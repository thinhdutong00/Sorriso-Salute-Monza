      ],
      trustItems: [
        "Diagnosi prima della soluzione",
        "Piano protesico personalizzato",
        "Controlli e manutenzione programmati",
      ],
      reviewSectionId: "recensioni-protesi",
      ctaSectionId: "prenota-protesi",
      ctaTitleId: "prosthetics-final-cta-title",
      ctaTitle: "Torna a masticare e sorridere con sicurezza.",
      ctaText:
        "Raccontaci cosa ti crea disagio: ti ricontattiamo per organizzare una valutazione protesica e indicarti con chiarezza il percorso più adatto.",
    }
