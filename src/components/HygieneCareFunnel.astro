---
import { sourceReviews } from "../data/reviews-seed";

type Props = {
  ctaHref?: string;
  variant?:
    | "hygiene"
    | "prosthetics"
    | "conservative"
    | "endodontics"
    | "periodontics"
    | "pediatric"
    | "gnathology"
    | "orthodontics";
};

const { ctaHref = "#richiesta", variant = "hygiene" } = Astro.props;

const getReview = (id: string) => {
  const review = sourceReviews.find((item) => item.id === id);

  if (!review) {
    throw new Error(`Recensione non trovata per il funnel clinico: ${id}`);
  }

  return review;
};

const funnelContent = variant === "prosthetics"
  ? {
      reviewIds: ["review-9100", "review-9105", "review-9102"],
      causesEyebrow: "Comprendere il problema",
      causesLead:
        "Dolore quando mastichi, sensibilità, irritazione o una protesi che si muove non sono fastidi da sopportare. Possono indicare che un dente, i tessuti di supporto o una vecchia protesi non stanno più lavorando correttamente.",
      clinicalNote:
        "Il sintomo indica che qualcosa va controllato, ma non basta da solo per scegliere la soluzione. Valutiamo denti, gengive, masticazione e protesi presenti per individuare la causa reale.",
      causes: [
        {
          number: "01",
          title: "Un dente è compromesso",
          text: "Carie profonde, fratture o vecchi restauri possono indebolire il dente e provocare dolore, sensibilità o difficoltà durante la masticazione.",
        },
        {
          number: "02",
          title: "Mancano uno o più denti",
          text: "Gli spazi vuoti possono alterare l’appoggio della masticazione e sovraccaricare denti, gengive e articolazioni, rendendo meno naturale mangiare e sorridere.",
        },
        {
          number: "03",
          title: "La protesi non è più stabile",
          text: "Una corona, un ponte o una protesi mobile usurati o non più adatti possono muoversi, creare pressione, trattenere residui e irritare i tessuti.",
        },
      ],
      solutionsLead:
        "Non devi adattarti a una masticazione scomoda. Una valutazione protesica completa permette di capire cosa conservare, cosa sostituire e quale soluzione può restituirti stabilità, funzione e sicurezza.",
      solutions: [
        {
          title: "Valutazione protesica precisa",
          text: "Controlliamo denti, gengive, appoggi, spazi e protesi presenti per definire con chiarezza il punto di partenza.",
          icon: "check",
        },
        {
          title: "Soluzione costruita sul tuo caso",
          text: "Corone, ponti, protesi mobili o soluzioni su impianti vengono confrontati in base alle condizioni reali della tua bocca.",
          icon: "spark",
        },
        {
          title: "Comfort e stabilità nel tempo",
          text: "Prove, regolazioni e controlli programmati aiutano a ottenere una protesi funzionale, pulibile e semplice da gestire ogni giorno.",
          icon: "shield",
        },
      ],
      processLead:
        "Ti accompagniamo dalla prima valutazione alla soluzione definitiva con un piano chiaro, passaggi spiegati e controlli programmati.",
      processSteps: [
        {
          number: "01",
          title: "Valutiamo",
          text: "Ascoltiamo il problema, esaminiamo denti, gengive e masticazione e definiamo gli approfondimenti realmente necessari.",
        },
        {
          number: "02",
          title: "Progettiamo",
          text: "Confrontiamo le alternative e costruiamo il piano protesico più adatto, chiarendo soluzione, fasi e tempi prima di iniziare.",
        },
        {
          number: "03",
          title: "Ripristiniamo",
          text: "Realizziamo la protesi, verifichiamo comfort e stabilità e programmiamo i controlli per mantenere il risultato nel tempo.",
