---
import {
  generalRequestServiceOptions,
  treatmentFormPresets,
} from "../data/categoryTreatments";
import {
  generalRequestFallbackSecondStepProfileId,
  generalRequestSecondStepProfiles,
  generalRequestServiceSecondStepProfiles,
  generalRequestTreatmentSecondStepOverrides,
  type GeneralRequestSecondStepProfileId,
} from "../data/generalRequestSecondStep";

export type Props = {
  /** Slug tecnico del servizio, come definito in categoryTreatments.ts. */
  presetService?: string;
  /** ID completo del trattamento (`categoria--trattamento`). */
  presetTreatment?: string;
  /** Default 1 per le props; lo step 2 richiede un servizio preselezionato valido. */
  initialStep?: 1 | 2;
  /** Pagina che contiene l'istanza; non modifica landing o referrer iniziali. */
  sourcePage?: string;
  /** Override del profilo iniziale, validato contro generalRequestSecondStep.ts. */
  secondStepProfileId?: GeneralRequestSecondStepProfileId;
  /** Adatta contenitore e gerarchia del titolo all'inserimento in un'altra pagina. */
  embedded?: boolean;
};

const {
  presetService,
  presetTreatment,
  initialStep,
  sourcePage,
  secondStepProfileId,
  embedded = false,
} = Astro.props;

const normalizedPresetService = presetService?.trim() || "";
const normalizedPresetTreatment = presetTreatment?.trim() || "";
const normalizedSourcePage = sourcePage?.trim() || "";
const normalizedSecondStepProfileId =
  secondStepProfileId && generalRequestSecondStepProfiles[secondStepProfileId]
    ? secondStepProfileId
    : "";
const hasPresetProps = Boolean(
  normalizedPresetService || normalizedPresetTreatment,
);
const hasExplicitInitialStep = initialStep === 1 || initialStep === 2;
const requestedInitialStep = initialStep === 2 ? 2 : 1;
const instanceId = `general-request-${globalThis.crypto.randomUUID()}`;
const formId = `${instanceId}-form`;
const titleId = `${instanceId}-title`;
const nameId = `${instanceId}-name`;
const phoneId = `${instanceId}-phone`;
const emailId = `${instanceId}-email`;
const privacyId = `${instanceId}-privacy`;
const HeadingTag = embedded ? "h2" : "h1";
const StepHeadingTag = embedded ? "h3" : "h2";

const serviceOptions = generalRequestServiceOptions.map((option) => ({
  slug: option.slug,
  label: option.label,
  displayLabel: option.displayLabel,
  group: option.group,
}));
const treatmentPresets = Object.values(treatmentFormPresets).map((preset) => ({
  treatmentId: preset.treatmentId,
  categoryId: preset.categoryId,
  serviceSlug: preset.serviceSlug,
  specificTreatmentValue: preset.specificTreatmentValue,
}));
const invalidSecondStepTreatmentIds = Object.keys(
  generalRequestTreatmentSecondStepOverrides,
).filter((treatmentId) => !treatmentFormPresets[treatmentId]);

if (invalidSecondStepTreatmentIds.length > 0) {
  throw new Error(
    `Configurazione step 2 non valida. Trattamenti sconosciuti: ${invalidSecondStepTreatmentIds.join(", ")}`,
  );
}

const secondStepProfiles = generalRequestSecondStepProfiles;
const serviceSecondStepProfileIds = generalRequestServiceSecondStepProfiles;
const treatmentSecondStepProfileIds = generalRequestTreatmentSecondStepOverrides;
const fallbackSecondStepProfileId = generalRequestFallbackSecondStepProfileId;
const serializedClientConfig = JSON.stringify({
  serviceOptions,
  treatmentPresets,
  secondStepProfiles,
  serviceSecondStepProfileIds,
  treatmentSecondStepProfileIds,
  fallbackSecondStepProfileId,
  normalizedPresetService,
  normalizedPresetTreatment,
  normalizedSourcePage,
  normalizedSecondStepProfileId,
  hasPresetProps,
  hasExplicitInitialStep,
  requestedInitialStep,
}).replaceAll("<", "\\u003c");
---

<section
  class:list={[
    "request-questionnaire",
    "general-request-form",
    { "general-request-form--embedded": embedded },
  ]}
  aria-labelledby={titleId}
  data-general-request-form={instanceId}
  data-embedded={String(embedded)}
>
  <div class="request-questionnaire__container">
    <form
      class="request-form"
      id={formId}
      action="/api/send-lead"
      method="post"
      aria-label="Modulo per richiedere una visita"
      autocomplete="on"
      novalidate
    >
      <div
        class="request-progress"
        role="progressbar"
        aria-label="Avanzamento richiesta"
        aria-valuemin="1"
        aria-valuemax="5"
        aria-valuenow="1"
      ></div>

      <header class="request-questionnaire__heading">
        <p class="request-questionnaire__eyebrow" data-step-eyebrow>
          Scegli il trattamento
        </p>
        <HeadingTag id={titleId}>
          <span>Anamnesi</span>
        </HeadingTag>
      </header>

      <div class="request-step is-active" data-step="1">
        <StepHeadingTag class="quiz-title">
          Per quale trattamento stai richiedendo la visita?
        </StepHeadingTag>
        <div
          class="quiz-options request-service-menu"
          data-field="servizio"
          role="group"
          aria-label="Scegli la tua esigenza"
        ></div>
      </div>

      <div class="request-step" data-step="2">
        <StepHeadingTag class="quiz-title" data-second-step-title>
          Da quanto tempo hai questo problema?
        </StepHeadingTag>
        <div
          class="quiz-options"
          data-field="rispostaAnamnestica"
          data-second-step-options
          role="group"
          aria-label="Seleziona da quanto tempo è presente il problema"
        ></div>
      </div>

      <div class="request-step" data-step="3">
        <StepHeadingTag class="quiz-title">
          Indica la tua fascia d’età
        </StepHeadingTag>
        <div
          class="quiz-options"
          data-field="fasciaEta"
          role="group"
          aria-label="Seleziona la tua fascia d’età"
        ></div>
      </div>

      <div class="request-step request-step--availability" data-step="4">
        <StepHeadingTag class="quiz-title">
          Quando preferisci venire?
        </StepHeadingTag>
        <div class="request-preferences">
          <fieldset class="request-preference-group">
            <legend>Giorni preferiti</legend>
            <div
              class="request-preference-options request-preference-options--days"
              data-field="giorniPreferiti"
              data-multiple="true"
            >
              <button class="request-preference-btn" type="button" data-value="Lunedì" aria-pressed="false">Lun</button>
              <button class="request-preference-btn" type="button" data-value="Martedì" aria-pressed="false">Mar</button>
              <button class="request-preference-btn" type="button" data-value="Mercoledì" aria-pressed="false">Mer</button>
              <button class="request-preference-btn" type="button" data-value="Giovedì" aria-pressed="false">Gio</button>
              <button class="request-preference-btn" type="button" data-value="Venerdì" aria-pressed="false">Ven</button>
              <button class="request-preference-btn" type="button" data-value="Sabato" aria-pressed="false">Sab</button>
            </div>
          </fieldset>

          <fieldset class="request-preference-group">
            <legend>Fascia oraria</legend>
            <div
              class="request-preference-options request-preference-options--time"
              data-field="fasciaOraria"
            >
              <button class="request-preference-btn" type="button" data-value="Mattina" aria-pressed="false">Mattina</button>
              <button class="request-preference-btn" type="button" data-value="Pomeriggio" aria-pressed="false">Pomeriggio</button>
              <button class="request-preference-btn" type="button" data-value="Sera" aria-pressed="false">Sera</button>
            </div>
          </fieldset>

          <fieldset class="request-preference-group">
            <legend>Disponibilità urgente?</legend>
            <div
              class="request-preference-options request-preference-options--urgent"
              data-field="disponibilitaUrgente"
            >
              <button class="request-preference-btn" type="button" data-value="Sì" aria-pressed="false">Sì</button>
              <button class="request-preference-btn" type="button" data-value="No" aria-pressed="false">No</button>
            </div>
          </fieldset>

          <fieldset class="request-preference-group">
            <legend>
              Come preferisci essere ricontattato?
              <span class="sr-only">Campo obbligatorio.</span>
            </legend>
            <div
              class="request-preference-options request-preference-options--contact"
              data-field="preferredContactChannel"
              role="group"
              aria-label="Seleziona il canale di contatto preferito"
            >
              <button class="request-preference-btn" type="button" data-value="telefono" aria-pressed="false">Telefono</button>
              <button class="request-preference-btn" type="button" data-value="whatsapp" aria-pressed="false">WhatsApp</button>
              <button class="request-preference-btn" type="button" data-value="email" aria-pressed="false">Email</button>
            </div>
          </fieldset>
        </div>
      </div>

      <div class="request-step" data-step="5">
        <StepHeadingTag class="quiz-title">
          Lascia i tuoi recapiti
        </StepHeadingTag>
        <div class="summary-box" data-summary-box></div>
        <div class="field-grid">
          <label for={nameId}>
            Nome e cognome
            <input
              id={nameId}
              name="nomeCompleto"
              type="text"
              autocomplete="section-visit name"
              autocapitalize="words"
              enterkeyhint="next"
              minlength="2"
              required
            />
          </label>
          <label for={phoneId}>
            Telefono
            <input
              id={phoneId}
              name="telefono"
              type="tel"
              inputmode="tel"
              autocomplete="section-visit tel"
              enterkeyhint="next"
              required
            />
          </label>
          <label for={emailId}>
            Email
            <input
              id={emailId}
              name="email"
              type="email"
              inputmode="email"
              autocomplete="section-visit email"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              enterkeyhint="next"
            />
          </label>
        </div>
        <label>
          Note/Messaggio (facoltativo)
          <textarea
            name="messaggio"
            placeholder="Aggiungi dettagli utili o sintomi particolari"
          ></textarea>
        </label>
        <label class="request-privacy" for={privacyId}>
          <input
            id={privacyId}
            name="privacy_consent"
            type="checkbox"
            required
          />
          <span>
            Ho letto la <a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a> e acconsento al trattamento dei dati per essere ricontattato in merito alla richiesta.
          </span>
        </label>
      </div>

      <p class="form-error" data-form-error aria-live="polite"></p>

      <div class="request-actions">
        <button
          class="request-btn request-btn-outline"
          type="button"
          data-prev-step
          hidden
        >
          Indietro
        </button>
        <button
          class="request-btn request-btn-primary"
          type="button"
          data-next-step
          disabled
        >
          Continua
        </button>
        <button
          class="request-btn request-btn-primary"
          type="submit"
          data-submit-step
          hidden
        >
          Invia la tua richiesta
        </button>
      </div>
    </form>
  </div>
  <script
    type="application/json"
    data-general-request-config
    set:html={serializedClientConfig}
  ></script>
</section>

<style is:global>
      body .general-request-form[data-general-request-form] {
        min-height: 100svh;
        padding: clamp(132px, 10vw, 172px) 24px clamp(96px, 9vw, 138px);
        background: var(--brand-secondary, #1e84b5);
        color: #fff;
      }

      body .general-request-form[data-general-request-form],
      body .general-request-form[data-general-request-form] *,
      body .general-request-form[data-general-request-form] *::before,
      body .general-request-form[data-general-request-form] *::after {
        box-sizing: border-box;
      }

      body .general-request-form[data-general-request-form].general-request-form--embedded {
        min-height: 0;
        padding: clamp(56px, 7vw, 88px) clamp(20px, 4vw, 48px);
      }

      body .general-request-form[data-general-request-form] .request-questionnaire__container {
        width: min(1020px, 100%);
        margin: 0 auto;
      }

      body .general-request-form[data-general-request-form] .request-form {
        display: grid;
        width: 100%;
        min-height: 0;
        padding: 0;
        scroll-margin-top: calc(var(--primary-site-header-height, 92px) + 24px);
        border: 0 !important;
        border-radius: 0;
        background: transparent !important;
        box-shadow: none !important;
        color: #fff !important;
        gap: 0;
      }

      body .general-request-form[data-general-request-form] .request-progress {
        --progress: 16.666%;
        position: relative;
        height: 4px;
        margin: 0 0 clamp(46px, 4vw, 60px);
        overflow: hidden;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.2) !important;
      }

      body .general-request-form[data-general-request-form] .request-progress::before {
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--progress);
        border-radius: inherit;
        background: #fff !important;
        content: "";
        transition: width 240ms ease;
      }

      body .general-request-form[data-general-request-form] .request-questionnaire__heading {
        display: grid;
        margin: 0 0 clamp(62px, 8vw, 96px);
        gap: 20px;
      }

      body .general-request-form[data-general-request-form] .request-questionnaire__eyebrow {
        margin: 0;
        color: rgba(255, 255, 255, 0.68) !important;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.24em;
        line-height: 1.2;
        text-transform: uppercase;
      }

      body .general-request-form[data-general-request-form] .request-questionnaire__heading :is(h1, h2) {
        display: grid;
        width: fit-content;
        max-width: 9ch;
        margin: 0;
        color: #fff !important;
        font-size: clamp(4.4rem, 9.5vw, 7.6rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 0.86;
      }

      body .general-request-form[data-general-request-form] .request-step {
        display: none;
      }

      body .general-request-form[data-general-request-form] .request-step.is-active {
        display: grid;
        min-height: 0;
        align-content: start;
        gap: 18px;
        animation: general-request-step-enter 220ms ease both;
      }

      @keyframes general-request-step-enter {
        from {
          opacity: 0;
          transform: translateY(6px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      body .general-request-form[data-general-request-form] .quiz-title {
        max-width: 30ch;
        margin: 0;
        color: #fff !important;
        font-size: clamp(1.7rem, 3.2vw, 2.35rem) !important;
        font-weight: 700 !important;
        line-height: 1.08 !important;
        text-transform: none !important;
      }

      body .general-request-form[data-general-request-form] .request-service-menu {
        max-height: min(62svh, 640px);
        overflow-y: auto;
        overscroll-behavior-y: contain;
        padding: 2px 10px 2px 2px;
        scrollbar-color: rgba(255, 255, 255, 0.5) transparent;
        scrollbar-gutter: stable;
        scrollbar-width: thin;
      }

      body .general-request-form[data-general-request-form] .request-service-menu::-webkit-scrollbar {
        width: 6px;
      }

      body .general-request-form[data-general-request-form] .request-service-menu::-webkit-scrollbar-track {
        background: transparent;
      }

      body .general-request-form[data-general-request-form] .request-service-menu::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.45);
      }

      body .general-request-form[data-general-request-form] .quiz-options {
        display: grid;
        gap: 14px;
      }

      body .general-request-form[data-general-request-form] .request-step.is-active > .quiz-options {
        margin-top: 10px;
      }

      body .general-request-form[data-general-request-form] .request-step--availability.is-active {
        gap: 18px;
      }

      body .general-request-form[data-general-request-form] .request-preferences {
        display: grid;
        margin-top: 10px;
        gap: 30px;
      }

      body .general-request-form[data-general-request-form] .request-preference-group {
        display: grid;
        min-width: 0;
        margin: 0;
        padding: 0;
        border: 0;
        gap: 0;
      }

      body .general-request-form[data-general-request-form] .request-preference-group legend {
        margin: 0;
        padding: 0;
        color: #fff !important;
        font-size: clamp(1rem, 1.4vw, 1.15rem);
        font-weight: 700;
        line-height: 1.2;
      }

      body .general-request-form[data-general-request-form] .request-preference-options {
        display: grid;
        margin-top: 16px;
        gap: 10px;
      }

      body .general-request-form[data-general-request-form] .request-preference-options--days {
        grid-template-columns: repeat(6, minmax(0, 1fr));
      }

      body .general-request-form[data-general-request-form] .request-preference-options--time,
      body .general-request-form[data-general-request-form] .request-preference-options--contact {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      body .general-request-form[data-general-request-form] .request-preference-options--urgent {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      body .general-request-form[data-general-request-form] .choice-btn {
        position: relative;
        display: grid;
        align-items: center;
        width: 100%;
        cursor: pointer;
        font: inherit;
        text-align: left;
        transition:
          border-color 160ms ease,
          background-color 160ms ease;
      }

      body .general-request-form[data-general-request-form] .choice-btn::before,
      body .general-request-form[data-general-request-form] .choice-btn::after {
        position: absolute;
        top: 50%;
        border-radius: 999px;
        content: "";
        transform: translateY(-50%);
        transition:
          border-color 160ms ease,
          background-color 160ms ease,
          opacity 160ms ease,
          transform 160ms ease;
      }

      body .general-request-form[data-general-request-form] .choice-btn::after {
        opacity: 0;
        transform: translateY(-50%) scale(0.55);
      }

      body .general-request-form[data-general-request-form]
        .choice-btn[aria-pressed="true"]::after {
        opacity: 1;
        transform: translateY(-50%) scale(1);
      }

      body .general-request-form[data-general-request-form]
        .request-form
        .request-preference-btn {
        min-height: 62px;
        padding: 0.85rem 1rem;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.055) !important;
        box-shadow: none !important;
        color: #fff !important;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
        transform: none !important;
        transition:
          border-color 180ms ease,
          background-color 180ms ease,
          color 180ms ease;
      }

      body .general-request-form[data-general-request-form]
        .request-form
        .request-preference-btn:is(:hover, :focus-visible) {
        border-color: rgba(255, 255, 255, 0.78) !important;
        background: rgba(255, 255, 255, 0.09) !important;
        box-shadow: none !important;
        color: #fff !important;
      }

      body .general-request-form[data-general-request-form]
        .request-form
        .request-preference-btn[aria-pressed="true"],
      body .general-request-form[data-general-request-form]
        .request-form
        .request-preference-btn[aria-pressed="true"]:is(
          :hover,
          :focus-visible
        ) {
        border-color: #fff !important;
        background: #fff !important;
        box-shadow: none !important;
        color: var(--brand-secondary, #1e84b5) !important;
      }

      @media (min-width: 981px) {
        body .general-request-form[data-general-request-form]
          .request-step[data-step="1"]
          .request-service-menu {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      body .general-request-form[data-general-request-form] .request-form .choice-btn,
      body .general-request-form[data-general-request-form] .request-form .choice-btn:hover,
      body .general-request-form[data-general-request-form] .request-form .choice-btn:focus-visible,
      body .general-request-form[data-general-request-form]
        .request-form
        .choice-btn[aria-pressed="true"] {
        min-height: 82px;
        padding: 1rem 4.5rem 1rem 1.55rem;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.055) !important;
        box-shadow: none !important;
        color: #fff !important;
        transform: none !important;
      }

      body .general-request-form[data-general-request-form] .request-form .choice-btn:hover,
      body .general-request-form[data-general-request-form] .request-form .choice-btn:focus-visible {
        border-color: rgba(255, 255, 255, 0.74) !important;
        background: rgba(255, 255, 255, 0.09) !important;
      }

      body .general-request-form[data-general-request-form]
        .request-form
        .choice-btn[aria-pressed="true"] {
        border-color: #fff !important;
        background: rgba(255, 255, 255, 0.14) !important;
      }

      body .general-request-form[data-general-request-form] .choice-btn strong {
        display: block;
        min-width: 0;
        overflow-wrap: anywhere;
        color: #fff !important;
        font-size: clamp(1rem, 1.55vw, 1.14rem);
        font-weight: 700;
        line-height: 1.25;
      }

      body .general-request-form[data-general-request-form] .request-form .choice-btn small {
        margin-top: 0.35rem;
        color: rgba(255, 255, 255, 0.66) !important;
        font-size: 0.88rem !important;
        font-weight: 400;
        line-height: 1.4;
      }

      body .general-request-form[data-general-request-form] .request-form .choice-btn::before {
        right: 1.35rem;
        width: 26px;
        height: 26px;
        border: 2px solid rgba(255, 255, 255, 0.44) !important;
        background: transparent !important;
        box-shadow: none !important;
      }

      body .general-request-form[data-general-request-form]
        .request-form
        .choice-btn:hover::before,
      body .general-request-form[data-general-request-form]
        .request-form
        .choice-btn:focus-visible::before,
      body .general-request-form[data-general-request-form]
        .request-form
        .choice-btn[aria-pressed="true"]::before {
        border-color: #fff !important;
        background: #fff !important;
        box-shadow: none !important;
      }

      body .general-request-form[data-general-request-form] .request-form .choice-btn::after {
        right: calc(1.35rem + 8px);
        width: 10px;
        height: 10px;
        background: var(--brand-secondary, #1e84b5) !important;
        box-shadow: none !important;
      }

      body .general-request-form[data-general-request-form] .field-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.82rem;
      }

      body .general-request-form[data-general-request-form]
        .field-grid
        label:first-child {
        grid-column: 1 / -1;
      }

      body .general-request-form[data-general-request-form] .request-form label {
        display: grid;
        gap: 0.35rem;
        color: #fff !important;
        font-size: 0.95rem !important;
        font-weight: 800;
      }

      body .general-request-form[data-general-request-form] .request-form input,
      body .general-request-form[data-general-request-form] .request-form textarea {
        width: 100%;
        min-height: 50px;
        padding: 0.78rem 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.34) !important;
        border-color: rgba(255, 255, 255, 0.34) !important;
        border-radius: 14px;
